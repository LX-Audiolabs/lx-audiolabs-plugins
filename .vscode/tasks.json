{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "aura install (release)",
            "type": "shell",
            "command": "cargo",
            "args": ["aura", "install", "--clap", "-plug", "${input:pluginName}", "--release"],
            "group": "build",
            "problemMatcher": "$rustc"
        }
    ],
    "inputs": [
        {
            "id": "pluginName",
            "type": "pickString",
            "description": "Plugin to build",
            "options": ["aether", "mensor", "equilibrium", "lucent", "lucent-relay", "meridian"]
        }
    ]
}
