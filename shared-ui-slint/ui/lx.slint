// LX-branded reusable Slint components — CI barrel.
//
// Import from a plugin (path relative to plugin ui/main.slint):
//   import {
//       Lx, LxShell, LxShellHeader, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
//       LxKnob, LxSpectrum, LxGoniometer, LxStereoMeter, ...
//   } from "../../../shared-ui-slint/ui/lx.slint";

import { Lx } from "lx-theme.slint";
import {
    LxPanel, LxSection, LxHeader, LxMonitorStrip, LxToggleBtn, LxButton, LxDangerBtn,
} from "lx-chrome.slint";
import {
    LxShellHeader, LxShellBody, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
} from "lx-shell.slint";
import {
    LxKnob, LxLineEdit, LxParamField, LxCycleBtn, LxSegmentedButton,
    LxSlider, LxEqBandColumn, LxBandColumn,
} from "lx-controls.slint";
import {
    LxMeterBar, LxGrMeter, LxCorrelation, LxStereoMeter, LxLevelPanel,
} from "lx-meters.slint";
import {
    LxSpectrum, LxEqCurve, LxGoniometer, LxCompDisplay,
} from "lx-viz.slint";
export {
    Lx,
    LxPanel, LxSection, LxHeader, LxMonitorStrip, LxToggleBtn, LxButton, LxDangerBtn,
    LxShellHeader, LxShellBody, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
    LxKnob, LxLineEdit, LxParamField, LxCycleBtn, LxSegmentedButton,
    LxSlider, LxEqBandColumn, LxBandColumn,
    LxMeterBar, LxGrMeter, LxCorrelation, LxStereoMeter, LxLevelPanel,
    LxSpectrum, LxEqCurve, LxGoniometer, LxCompDisplay,
}

// Compile anchor for shared-ui-slint crate.
export component LxGallery inherits Window {
    title: "LX Shared UI";
    preferred-width: Lx.window-w;
    preferred-height: Lx.window-h;
    background: Lx.window;

    VerticalLayout {
        spacing: 0;

        LxShellHeader {
            plugin-name: "GALLERY";
            version: "0.1";
        }

        LxShellBody {
            LxShellLeft {
                title: "LEFT BAR";
                Text {
                    text: "presets / vault";
                    font-size: Lx.font-sm;
                    color: Lx.text-muted;
                }
            }

            LxShellMain {
                Text {
                    text: "MAIN PANEL";
                    font-size: Lx.font-lg;
                    color: Lx.amber-hot;
                }
                LxMeterBar {
                    height: 12px;
                    level: 0.65;
                    bar-color: Lx.amber;
                }
            }

            LxShellRight {
                title: "RIGHT BAR";
                Text {
                    text: "meters / gonio";
                    font-size: Lx.font-sm;
                    color: Lx.text-muted;
                }
            }
        }

        LxShellFooter {
            Text {
                text: "FOOTER";
                font-size: Lx.font-sm;
                color: Lx.amber-hot;
                vertical-alignment: center;
            }
        }
    }
}
