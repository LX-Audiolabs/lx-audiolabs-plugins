// Frozen plugin shell zones — Header / Left / Main / Right / Footer.
// Vault ui-layout-spec: 990×660, header 50, footer 110, right bar 155.
//
// Canonical composition:
//
//   VerticalLayout {
//       spacing: 0;
//       LxShellHeader {
//           plugin-name: "MERIDIAN";
//           HorizontalLayout {
//               LxToggleBtn { label: "MONO"; ... }
//               LxToggleBtn { label: "DELTA"; ... }
//               LxToggleBtn { label: "BYPASS"; ... }
//           }
//       }
//       LxShellBody {
//           LxShellLeft  { title: "VAULT PRESETS"; /* ... */ }
//           LxShellMain  { /* spectrum + EQ */ }
//           LxShellRight { title: "OUTPUT LEVEL";  /* meters */ }
//       }
//       LxShellFooter { /* compressor / pan / width / reset */ }
//   }
//
// LxShellHeader accepts caller-supplied children on the right side, which are
// automatically vertically centered. LxShellBody is the horizontal body row.

import { Lx } from "lx-theme.slint";

// ── Zones ────────────────────────────────────────────────────────────────────

/// Left sidebar (vault / presets). Default 180px.
export component LxShellLeft inherits Rectangle {
    in property <length> bar-width: Lx.left-bar-w;
    in property <string> title: "";

    // Fixed width only — Slint forbids width + min/max-width together.
    width: root.bar-width;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    background: Lx.panel;

    VerticalLayout {
        padding: 8px;
        spacing: Lx.gap-sm;

        if root.title != "": Text {
            text: root.title;
            font-size: 13px;
            font-weight: 700;
            color: Lx.text;
            vertical-stretch: 0;
        }

        @children
    }
}

/// Center main panel — fills remaining space.
/// min-width:0 so left/right frozen bars are not shoved off-screen.
export component LxShellMain inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 0px;
    clip: true;
    background: #0f0f10;

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        @children
    }
}

/// Right sidebar (output level / meters / gonio). Frozen 155px.
export component LxShellRight inherits Rectangle {
    in property <length> bar-width: Lx.right-bar-w;
    in property <string> title: "OUTPUT LEVEL";

    // Fixed width only — no min/max alongside width.
    width: root.bar-width;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    background: #1a1a1a;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        if root.title != "": Text {
            text: root.title;
            font-size: 12px;
            font-weight: 600;
            color: Lx.text-secondary;
            vertical-stretch: 0;
        }

        @children
    }
}

/// Footer strip. Frozen 110px.
export component LxShellFooter inherits Rectangle {
    in property <length> bar-height: Lx.footer-h;

    height: root.bar-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: Lx.panel;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        alignment: center;
        @children
    }
}

// ── Header ───────────────────────────────────────────────────────────────────

/// Brand + plugin name + version (left). Custom actions are passed as children
/// on the right and are automatically vertically centered. Frozen 50px.
export component LxShellHeader inherits Rectangle {
    in property <string> brand-left: "LX";
    in property <string> brand-right: "AUDIOLABS";
    in property <string> plugin-name: "";
    in property <string> version: "";
    in property <string> status-text: "";

    height: Lx.header-h;
    vertical-stretch: 0;
    background: #141414;

    // stretch = fill 50px height so spacer expands horizontally (brand LEFT, actions RIGHT).
    // Nested rows use alignment:center so content sits mid-header (not top-stuck).
    // Do NOT use outer alignment:center — that packs brand+actions into the middle.
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 0;
        alignment: stretch;

        // ── Left: logo + plugin info ──
        HorizontalLayout {
            spacing: 6px;
            alignment: center;
            horizontal-stretch: 0;
            vertical-stretch: 0;

            Text {
                text: root.brand-left;
                font-size: 18px;
                font-weight: 700;
                color: Lx.amber;
                vertical-alignment: center;
            }
            Text {
                text: root.brand-right;
                font-size: 18px;
                font-weight: 700;
                color: Lx.text;
                vertical-alignment: center;
            }

            Rectangle {
                width: 14px;
                background: transparent;
            }
            Rectangle {
                width: 1px;
                height: 28px;
                background: #2e3838;
            }
            Rectangle {
                width: 14px;
                background: transparent;
            }

            VerticalLayout {
                spacing: 0;
                alignment: center;
                horizontal-stretch: 0;

                Text {
                    text: root.plugin-name;
                    font-size: 13px;
                    font-weight: 700;
                    color: #ffa64d;
                }
                if root.version != "": Text {
                    text: "v" + root.version;
                    font-size: 10px;
                    color: #808080;
                }
            }

            if root.status-text != "": Text {
                text: root.status-text;
                font-size: Lx.font-sm;
                color: Lx.text-secondary;
                vertical-alignment: center;
            }
        }

        // ── Center: flex spacer pushes actions to the right ──
        Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            background: transparent;
        }

        // ── Right: caller-supplied actions, vertically centered ──
        HorizontalLayout {
            spacing: 4px;
            alignment: center;
            horizontal-stretch: 0;
            vertical-stretch: 0;

            @children
        }
    }
}

// ── Sugar: body row only ─────────────────────────────────────────────────────

/// Horizontal body row. Children = LxShellLeft / LxShellMain / LxShellRight.
/// Pair with a sibling `LxShellHeader` above and `LxShellFooter` below inside a
/// VerticalLayout for the full plugin table.
export component LxShellBody inherits Rectangle {
    background: Lx.window;
    vertical-stretch: 1;
    horizontal-stretch: 1;

    HorizontalLayout {
        vertical-stretch: 1;
        horizontal-stretch: 1;
        min-width: 0px;
        spacing: 0;
        // Keep left | main | right in bounds — don't let main preferred-width overflow.
        alignment: stretch;
        @children
    }
}
