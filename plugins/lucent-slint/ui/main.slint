import {
    Lx, LxShellHeader, LxShellBody, LxShellMain, LxShellRight, LxShellLeft,
    LxKnob, LxToggleBtn, LxButton, LxLineEdit, LxSpectrum, LxSegmentedButton, LxPanel, LxSection,
    LxStereoMeter,
} from "../../../crates/lx-ui-slint/ui/lx.slint";

/// Lucent — spectrum analyser UI (Slint-native, not a Vizia port).
export component LucentUi inherits Window {
    preferred-width: 990px;
    preferred-height: 550px;
    min-width: 800px;
    min-height: 480px;
    title: "Lucent";
    background: Lx.window;

    in property <string> version: "1.0.0";

    // Identity
    in-out property <string> display_name: "";
    callback display_name_changed(string);

    // Analyze
    in-out property <float> analyze_mode: 0.0; // Own / Relay / Both
    callback analyze_mode_changed(float);
    in-out property <bool> resonance_active: true;
    callback resonance_active_changed(bool);
    in-out property <bool> masking_active: true;
    callback masking_active_changed(bool);
    in-out property <bool> bypass_active: false;
    callback bypass_active_changed(bool);
    in-out property <float> sensitivity: 0.5;
    in property <string> sensitivity_text: "50%";
    callback sensitivity_changed(float);

    // SPAN-like display: 1/3-oct smooth (default off) + session SNAP
    in-out property <bool> spectrum_smooth: false;
    callback spectrum_smooth_changed(bool);
    callback snap_clicked();
    in property <string> snap_status: "";

    // Viz / telemetry
    in property <string> spectrum_cmds: "";
    in property <string> mask_cmds: "";
    in property <string> resonance_line: "—";
    in property <string> masking_line: "—";
    in property <string> status_line: "";
    in property <string> peak_text: "—";
    in property <float> peak_l: 0.0;
    in property <float> peak_r: 0.0;
    in property <int> relay_count: 0;
    // SPAN range labels (−18 top … −78 bottom)
    in property <string> db_top: "-18 dB";
    in property <string> db_mid: "-48";
    in property <string> db_bot: "-78";

    VerticalLayout {
        padding: 0;
        spacing: 0;

        LxShellHeader {
            plugin-name: "Lucent";
            version: root.version;
            status-text: root.status_line;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text {
                    text: "Name";
                    color: Lx.text-muted;
                    font-size: Lx.font-xs;
                    vertical-alignment: center;
                }
                LxLineEdit {
                    text <=> root.display_name;
                    light: true;
                    field-width: 160px;
                    accepted => { root.display_name_changed(self.text); }
                    committed => { root.display_name_changed(self.text); }
                }
                LxToggleBtn {
                    label: "SMOOTH";
                    small: true;
                    active <=> root.spectrum_smooth;
                    toggled => { root.spectrum_smooth_changed(self.active); }
                }
                LxButton {
                    text: "SNAP";
                    clicked => { root.snap_clicked(); }
                }
                LxToggleBtn {
                    label: "BYPASS";
                    small: true;
                    danger: true;
                    active <=> root.bypass_active;
                    toggled => { root.bypass_active_changed(self.active); }
                }
            }
        }

        LxShellBody {
            // Left: detectors summary
            LxShellLeft {
                VerticalLayout {
                    padding: Lx.pad-md;
                    spacing: Lx.gap-md;

                    LxSection {
                        title: "Detectors";
                        VerticalLayout {
                            spacing: 8px;
                            LxToggleBtn {
                                label: "Resonance";
                                active <=> root.resonance_active;
                                toggled => { root.resonance_active_changed(self.active); }
                            }
                            Text {
                                text: root.resonance_line;
                                color: Lx.text-secondary;
                                font-size: Lx.font-xs;
                                wrap: word-wrap;
                            }
                            LxToggleBtn {
                                label: "Masking";
                                active <=> root.masking_active;
                                toggled => { root.masking_active_changed(self.active); }
                            }
                            Text {
                                text: root.masking_line;
                                color: Lx.text-secondary;
                                font-size: Lx.font-xs;
                                wrap: word-wrap;
                            }
                        }
                    }

                    LxSection {
                        title: "Network";
                        Text {
                            text: root.relay_count == 0
                                ? "No relays online"
                                : root.relay_count == 1
                                    ? "1 relay online"
                                    : root.relay_count + " relays online";
                            color: root.relay_count > 0 ? Lx.green : Lx.text-muted;
                            font-size: Lx.font-sm;
                        }
                    }
                }
            }

            // Main: spectrum stage
            LxShellMain {
                VerticalLayout {
                    padding: Lx.pad-md;
                    spacing: Lx.gap-sm;

                    Rectangle {
                        vertical-stretch: 1;
                        horizontal-stretch: 1;
                        background: Lx.panel;
                        border-radius: Lx.radius-md;
                        clip: true;

                        LxSpectrum {
                            width: 100%;
                            height: 100%;
                            commands: root.spectrum_cmds;
                            path-w: 900;
                            path-h: 400;
                            db-top: root.db_top;
                            db-mid: root.db_mid;
                            db-bot: root.db_bot;
                        }

                        // Masking overlay path (stroke-only style via second spectrum tint)
                        if root.mask_cmds != "": Path {
                            x: 0; y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0; viewbox-y: 0;
                            viewbox-width: 900; viewbox-height: 400;
                            commands: root.mask_cmds;
                            fill: #e0454533;
                            stroke: Lx.crimson;
                            stroke-width: 1px;
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Text {
                            text: "Peak " + root.peak_text;
                            color: Lx.text-secondary;
                            font-size: Lx.font-sm;
                            vertical-alignment: center;
                        }
                        if root.snap_status != "": Text {
                            text: root.snap_status;
                            color: Lx.amber;
                            font-size: Lx.font-xs;
                            vertical-alignment: center;
                        }
                        Text {
                            text: "20 Hz — 20 kHz  ·  −78…−18 dB";
                            color: Lx.text-dim;
                            font-size: Lx.font-xs;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                        }
                    }
                }
            }

            // Right: mode + sensitivity + meters
            LxShellRight {
                VerticalLayout {
                    padding: Lx.pad-md;
                    spacing: Lx.gap-lg;
                    alignment: start;

                    Text {
                        text: "SOURCE";
                        color: Lx.amber;
                        font-size: Lx.font-xs;
                        font-weight: 700;
                    }
                    LxSegmentedButton {
                        choices: ["Own", "Relay", "Both"];
                        index <=> root.analyze_mode;
                        changed => { root.analyze_mode_changed(self.index); }
                    }

                    LxKnob {
                        label: "Sensitivity";
                        value <=> root.sensitivity;
                        value-text: root.sensitivity_text;
                        changed => { root.sensitivity_changed(self.value); }
                    }

                    Text {
                        text: "LEVEL";
                        color: Lx.amber;
                        font-size: Lx.font-xs;
                        font-weight: 700;
                    }
                    LxStereoMeter {
                        level-l: root.peak_l;
                        level-r: root.peak_r;
                        min-height: 160px;
                    }
                }
            }
        }
    }
}
