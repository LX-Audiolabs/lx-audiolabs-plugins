import { Palette } from "std-widgets.slint";
import {
    Lx, LxShell, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
    LxKnob, LxSegmentedButton, LxToggle, LxToggleBtn, LxButton, LxDangerBtn, LxLineEdit,
    LxSpectrum, LxEqCurve, LxGoniometer, LxStereoMeter, LxGrMeter, LxCorrelation, LxCompDisplay,
} from "../../../shared-ui-slint/ui/lx.slint";
import "JetBrainsMono-Regular.ttf";

export component MeridianUi inherits Window {
    // --- float params (normalized) + formatted text ---
    in-out property <float> hpf_freq: 0.5; in property <string> hpf_freq_text: "";
    callback hpf_freq_changed(float);
    in-out property <float> lpf_freq: 0.5; in property <string> lpf_freq_text: "";
    callback lpf_freq_changed(float);

    in-out property <float> bass_gain: 0.5; in property <string> bass_gain_text: "";
    callback bass_gain_changed(float);
    in-out property <float> lo_mid_gain: 0.5; in property <string> lo_mid_gain_text: "";
    callback lo_mid_gain_changed(float);
    in-out property <float> mid_gain: 0.5; in property <string> mid_gain_text: "";
    callback mid_gain_changed(float);
    in-out property <float> high_gain: 0.5; in property <string> high_gain_text: "";
    callback high_gain_changed(float);
    in-out property <float> excite_gain: 0.5; in property <string> excite_gain_text: "";
    callback excite_gain_changed(float);

    in-out property <float> eq_freq_1: 0.5; in property <string> eq_freq_1_text: "";
    callback eq_freq_1_changed(float);
    in-out property <float> eq_freq_2: 0.5; in property <string> eq_freq_2_text: "";
    callback eq_freq_2_changed(float);
    in-out property <float> eq_freq_3: 0.5; in property <string> eq_freq_3_text: "";
    callback eq_freq_3_changed(float);
    in-out property <float> eq_freq_4: 0.5; in property <string> eq_freq_4_text: "";
    callback eq_freq_4_changed(float);
    in-out property <float> eq_freq_5: 0.5; in property <string> eq_freq_5_text: "";
    callback eq_freq_5_changed(float);

    in-out property <float> tilt_gain: 0.5; in property <string> tilt_gain_text: "";
    callback tilt_gain_changed(float);

    in-out property <float> warmth_drive: 0.0; in property <string> warmth_drive_text: "";
    callback warmth_drive_changed(float);
    in-out property <float> warmth_mix: 0.0; in property <string> warmth_mix_text: "";
    callback warmth_mix_changed(float);

    in-out property <float> excite_amount: 0.0; in property <string> excite_amount_text: "";
    callback excite_amount_changed(float);
    in-out property <float> excite_blend: 0.0; in property <string> excite_blend_text: "";
    callback excite_blend_changed(float);
    in-out property <float> excite_freq: 0.5; in property <string> excite_freq_text: "";
    callback excite_freq_changed(float);

    in-out property <float> comp_threshold: 0.5; in property <string> comp_threshold_text: "";
    callback comp_threshold_changed(float);
    in-out property <float> comp_mix: 0.0; in property <string> comp_mix_text: "";
    callback comp_mix_changed(float);
    in-out property <float> comp_attack: 0.5; in property <string> comp_attack_text: "";
    callback comp_attack_changed(float);
    in-out property <float> comp_release: 0.5; in property <string> comp_release_text: "";
    callback comp_release_changed(float);
    in-out property <float> comp_character: 0.5; in property <string> comp_character_text: "";
    callback comp_character_changed(float);
    in-out property <float> comp_makeup: 0.0; in property <string> comp_makeup_text: "";
    callback comp_makeup_changed(float);

    in-out property <float> inflate_effect: 0.0; in property <string> inflate_effect_text: "";
    callback inflate_effect_changed(float);
    in-out property <float> inflate_curve: 0.5; in property <string> inflate_curve_text: "";
    callback inflate_curve_changed(float);

    in-out property <float> stereo_width: 0.5; in property <string> stereo_width_text: "";
    callback stereo_width_changed(float);
    in-out property <float> pan: 0.5; in property <string> pan_text: "";
    callback pan_changed(float);
    in-out property <float> output_gain: 0.5; in property <string> output_gain_text: "";
    callback output_gain_changed(float);

    // --- int params (slope selectors) ---
    in-out property <float> cut_slope: 0.0; callback cut_slope_changed(float);
    in-out property <float> bass_slope: 1.0; callback bass_slope_changed(float);
    in-out property <float> lo_mid_slope: 1.0; callback lo_mid_slope_changed(float);
    in-out property <float> mid_slope: 1.0; callback mid_slope_changed(float);
    in-out property <float> high_slope: 1.0; callback high_slope_changed(float);
    in-out property <float> excite_slope: 1.0; callback excite_slope_changed(float);

    // --- bool params ---
    in-out property <bool> mono_active: false; callback mono_active_changed(bool);
    in-out property <bool> delta_active: false; callback delta_active_changed(bool);
    in-out property <bool> bypass_active: false; callback bypass_active_changed(bool);
    in-out property <bool> inflate_band_split: false; callback inflate_band_split_changed(bool);
    in-out property <bool> inflate_clip: false; callback inflate_clip_changed(bool);

    // --- visualization ---
    in property <string> spectrum_path: "";
    in property <string> curve_cmds: "";
    in property <string> gonio_path: "";
    in property <float> meter_l: 0.0;
    in property <float> meter_r: 0.0;
    in property <float> peak_hold_l: 0.0;
    in property <float> peak_hold_r: 0.0;
    in property <float> gr: 0.0;
    in property <float> comp_peak: 0.0;
    in property <string> comp_peak_text: "";
    in property <string> gr_text: "";
    in property <float> correlation: 0.0;
    in property <float> balance: 0.0;
    in property <string> corr_text: "";
    in property <string> balance_text: "";
    in property <string> peak_l_text: "";
    in property <string> peak_r_text: "";

    // Preset UI state (local for now — vault wiring later)
    in-out property <string> preset_name: "";
    in-out property <string> vault_path: "";
    in property <string> snap_label: "SNAP";

    callback reset_peaks;
    callback snap_clicked;
    callback save_clicked;
    callback vault_path_changed(string);
    callback reset_clicked;

    init => { Palette.color-scheme = ColorScheme.dark; }

    title: "Meridian";
    background: Lx.window;
    // Frozen vault size
    preferred-width: Lx.window-w;
    preferred-height: Lx.window-h;
    min-width: Lx.window-w;
    min-height: Lx.window-h;
    default-font-family: Lx.font-family;

    // ═══════════════════════════════════════════════════════════════════════
    // TABLE LAYOUT
    //   ┌──────────────────────────────────────────────────────────────┐
    //   │ HEADER 50px                                                  │
    //   ├──────────┬───────────────────────────────────┬───────────────┤
    //   │ LEFT 180 │ MAIN (fill)                       │ RIGHT 155     │
    //   │          │                                   │               │
    //   ├──────────┴───────────────────────────────────┴───────────────┤
    //   │ FOOTER 110px                                                 │
    //   └──────────────────────────────────────────────────────────────┘
    // ═══════════════════════════════════════════════════════════════════════

    VerticalLayout {
        spacing: 0;

        // ── HEADER + BODY ────────────────────────────────────────────────
        LxShell {
            plugin-name: "MERIDIAN";
            version: "1.9.7";
            show-monitor: true;
            mono <=> root.mono_active;
            delta <=> root.delta_active;
            bypass <=> root.bypass_active;
            mono_changed(v) => { root.mono_active_changed(v); }
            delta_changed(v) => { root.delta_active_changed(v); }
            bypass_changed(v) => { root.bypass_active_changed(v); }

            // ── LEFT BAR: vault / presets ─────────────────────────────
            LxShellLeft {
                title: "VAULT PRESETS";

                LxLineEdit {
                    placeholder-text: "Preset Name...";
                    text <=> root.preset_name;
                    vertical-stretch: 0;
                }

                HorizontalLayout {
                    spacing: Lx.gap-sm;
                    vertical-stretch: 0;

                    LxButton {
                        text: root.snap_label;
                        primary: true;
                        horizontal-stretch: 1;
                        clicked => { root.snap_clicked(); }
                    }

                    LxButton {
                        text: "SAVE";
                        horizontal-stretch: 1;
                        clicked => { root.save_clicked(); }
                    }
                }

                LxButton {
                    text: "VAULT SETUP";
                    vertical-stretch: 0;
                    clicked => { vault_setup_popup.show(); }
                }


                // Preset list placeholder
                Rectangle {
                    vertical-stretch: 1;
                    background: #0c0c0e;
                    border-radius: Lx.radius-sm;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;

                        Text {
                            text: "── Factory ──";
                            font-size: Lx.font-xs;
                            font-weight: 700;
                            color: Lx.amber;
                        }
                        Text {
                            text: "  (vault wiring soon)";
                            font-size: Lx.font-xs;
                            color: Lx.text-muted;
                        }
                        Text {
                            text: "── User ──";
                            font-size: Lx.font-xs;
                            font-weight: 700;
                            color: Lx.amber;
                        }
                        Text {
                            text: "  (empty)";
                            font-size: Lx.font-xs;
                            color: Lx.text-muted;
                        }
                    }
                }
            }

            // ── MAIN PANEL: spectrum + EQ / filter / dynamics ─────────
            LxShellMain {
                // Spectrum with amber EQ curve overlaid on top.
                Rectangle {
                    height: 200px;
                    vertical-stretch: 0;
                    background: #0f0f14;
                    border-radius: Lx.radius-md;
                    clip: true;

                    LxSpectrum {
                        width: 100%;
                        height: 100%;
                        commands: root.spectrum_path;
                        path-w: 620;
                        path-h: 200;
                        db-top: "0 dB";
                        db-mid: "-45";
                        db-bot: "-90";
                    }

                    LxEqCurve {
                        width: 100%;
                        height: 100%;
                        commands: root.curve_cmds;
                        path-w: 620;
                        path-h: 200;
                        show-grid: false;
                        show-labels: true;
                        labels-right: true;
                    }
                }

                // ── MAIN PANEL CONTROLS: 3 rows (original Meridian layout) ────────
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 4px;

                    // Row 1: FILTER | WARMTH | EXCITER | TILT EQ
                    HorizontalLayout {
                        spacing: 0;
                        alignment: stretch;

                        // FILTER
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            padding-left: 6px;
                            padding-right: 6px;
                            horizontal-stretch: 1;

                            Text {
                                text: "FILTER";
                                font-size: Lx.font-xs;
                                font-weight: 700;
                                color: Lx.amber-hot;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                LxKnob { label: "LOW CUT"; value <=> root.hpf_freq; value-text: root.hpf_freq_text; changed(v) => { root.hpf_freq_changed(v); } }
                                VerticalLayout {
                                    alignment: center;
                                    height: 100%;
                                    LxSegmentedButton {
                                        choices: ["12 dB", "24 dB"];
                                        index <=> root.cut_slope;
                                        changed(v) => { root.cut_slope_changed(v); }
                                    }
                                }
                                LxKnob { label: "HIGH CUT"; value <=> root.lpf_freq; value-text: root.lpf_freq_text; changed(v) => { root.lpf_freq_changed(v); } }
                            }
                        }

                        Rectangle { width: 1px; height: 100%; background: Lx.steel; }

                        // WARMTH
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            padding-left: 6px;
                            padding-right: 6px;
                            horizontal-stretch: 1;

                            Text {
                                text: "WARMTH";
                                font-size: Lx.font-xs;
                                font-weight: 700;
                                color: Lx.amber-hot;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                LxKnob { label: "DRIVE"; value <=> root.warmth_drive; value-text: root.warmth_drive_text; changed(v) => { root.warmth_drive_changed(v); } }
                                LxKnob { label: "W/MIX"; value <=> root.warmth_mix; value-text: root.warmth_mix_text; changed(v) => { root.warmth_mix_changed(v); } }
                            }
                        }

                        Rectangle { width: 1px; height: 100%; background: Lx.steel; }

                        // EXCITER
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            padding-left: 6px;
                            padding-right: 6px;
                            horizontal-stretch: 1;

                            Text {
                                text: "EXCITER";
                                font-size: Lx.font-xs;
                                font-weight: 700;
                                color: Lx.amber-hot;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                LxKnob { label: "AMT"; value <=> root.excite_amount; value-text: root.excite_amount_text; changed(v) => { root.excite_amount_changed(v); } }
                                LxKnob { label: "BLEND"; value <=> root.excite_blend; value-text: root.excite_blend_text; changed(v) => { root.excite_blend_changed(v); } }
                                LxKnob { label: "FREQ"; value <=> root.excite_freq; value-text: root.excite_freq_text; changed(v) => { root.excite_freq_changed(v); } }
                            }
                        }

                        Rectangle { width: 1px; height: 100%; background: Lx.steel; }

                        // TILT EQ
                        VerticalLayout {
                            spacing: 2px;
                            alignment: start;
                            padding-left: 6px;
                            padding-right: 6px;
                            horizontal-stretch: 1;

                            Text {
                                text: "TILT EQ";
                                font-size: Lx.font-xs;
                                font-weight: 700;
                                color: Lx.amber-hot;
                                horizontal-alignment: center;
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                alignment: center;
                                LxKnob { label: "SLOPE"; value <=> root.tilt_gain; value-text: root.tilt_gain_text; changed(v) => { root.tilt_gain_changed(v); } }
                            }
                        }
                    }

                    // Row 2: 5-BAND EQ gains
                    VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        Text {
                            text: "5-BAND EQ — GAIN";
                            font-size: Lx.font-xs;
                            font-weight: 700;
                            color: Lx.amber-hot;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: space-around;
                            LxKnob { label: "LO"; value <=> root.bass_gain; value-text: root.bass_gain_text; changed(v) => { root.bass_gain_changed(v); } }
                            LxKnob { label: "LM"; value <=> root.lo_mid_gain; value-text: root.lo_mid_gain_text; changed(v) => { root.lo_mid_gain_changed(v); } }
                            LxKnob { label: "MID"; value <=> root.mid_gain; value-text: root.mid_gain_text; changed(v) => { root.mid_gain_changed(v); } }
                            LxKnob { label: "HM"; value <=> root.high_gain; value-text: root.high_gain_text; changed(v) => { root.high_gain_changed(v); } }
                            LxKnob { label: "HI"; value <=> root.excite_gain; value-text: root.excite_gain_text; changed(v) => { root.excite_gain_changed(v); } }
                        }
                    }

                    // Row 3: 5-BAND EQ frequencies + slope selectors
                    VerticalLayout {
                        spacing: 2px;
                        alignment: start;

                        Text {
                            text: "5-BAND EQ — FREQUENCY / SLOPE";
                            font-size: Lx.font-xs;
                            font-weight: 700;
                            color: Lx.amber-hot;
                            horizontal-alignment: center;
                        }
                        HorizontalLayout {
                            spacing: 4px;
                            alignment: space-around;

                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                LxKnob { label: "LO FREQ"; value <=> root.eq_freq_1; value-text: root.eq_freq_1_text; changed(v) => { root.eq_freq_1_changed(v); } }
                                LxSegmentedButton { index <=> root.bass_slope; changed(v) => { root.bass_slope_changed(v); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                LxKnob { label: "LM FREQ"; value <=> root.eq_freq_2; value-text: root.eq_freq_2_text; changed(v) => { root.eq_freq_2_changed(v); } }
                                LxSegmentedButton { index <=> root.lo_mid_slope; changed(v) => { root.lo_mid_slope_changed(v); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                LxKnob { label: "MID FREQ"; value <=> root.eq_freq_3; value-text: root.eq_freq_3_text; changed(v) => { root.eq_freq_3_changed(v); } }
                                LxSegmentedButton { index <=> root.mid_slope; changed(v) => { root.mid_slope_changed(v); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                LxKnob { label: "HM FREQ"; value <=> root.eq_freq_4; value-text: root.eq_freq_4_text; changed(v) => { root.eq_freq_4_changed(v); } }
                                LxSegmentedButton { index <=> root.high_slope; changed(v) => { root.high_slope_changed(v); } }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                LxKnob { label: "HI FREQ"; value <=> root.eq_freq_5; value-text: root.eq_freq_5_text; changed(v) => { root.eq_freq_5_changed(v); } }
                                LxSegmentedButton { index <=> root.excite_slope; changed(v) => { root.excite_slope_changed(v); } }
                            }
                        }
                    }
                }
            }

            // ── RIGHT BAR: output gain + meters + gonio ───────────────
            LxShellRight {
                title: "OUTPUT LEVEL";

                LxKnob {
                    label: "OUT GAIN";
                    value <=> root.output_gain;
                    value-text: root.output_gain_text;
                    changed(v) => { root.output_gain_changed(v); }
                    vertical-stretch: 0;
                }

                Text {
                    text: "OUTPUT PEAK";
                    font-size: Lx.font-xs;
                    color: Lx.text-muted;
                    vertical-stretch: 0;
                }

                LxStereoMeter {
                    height: 160px;
                    vertical-stretch: 0;
                    level-l: root.meter_l;
                    level-r: root.meter_r;
                    hold-l: root.peak_hold_l;
                    hold-r: root.peak_hold_r;
                    balance: root.balance;
                    reset-peaks => { root.reset_peaks(); }
                }

                // Peak readouts
                HorizontalLayout {
                    spacing: 4px;
                    vertical-stretch: 0;
                    Text {
                        text: root.peak_l_text != "" ? root.peak_l_text : "L";
                        font-size: Lx.font-sm;
                        color: Lx.amber;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "dB";
                        font-size: Lx.font-xs;
                        color: Lx.text-muted;
                    }
                    Text {
                        text: root.peak_r_text != "" ? root.peak_r_text : "R";
                        font-size: Lx.font-sm;
                        color: Lx.amber;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }

                LxCorrelation {
                    correlation: root.correlation;
                    text: root.corr_text;
                    vertical-stretch: 0;
                }

                // Spacer pushes gonio to bottom (matches Vizia)
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "GONIOMETER";
                    font-size: Lx.font-xs;
                    color: Lx.text-muted;
                    vertical-stretch: 0;
                }

                LxGoniometer {
                    height: Lx.gonio-h;
                    vertical-stretch: 0;
                    commands: root.gonio_path;
                    path-w: 139;
                    path-h: 139;
                }
            }
        }

        // ── FOOTER: compressor + stereo + reset ──────────────────────────
        LxShellFooter {
            // Compressor block (left)
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 0;
                alignment: start;

                Text {
                    text: "COMPRESSOR";
                    font-size: Lx.font-xs;
                    font-weight: 700;
                    color: Lx.amber-hot;
                }
                HorizontalLayout {
                    spacing: 2px;
                    LxKnob { label: "THRESH"; small: true; value <=> root.comp_threshold; value-text: root.comp_threshold_text; changed(v) => { root.comp_threshold_changed(v); } }
                    LxKnob { label: "MIX"; small: true; value <=> root.comp_mix; value-text: root.comp_mix_text; changed(v) => { root.comp_mix_changed(v); } }
                    LxKnob { label: "ATTACK"; small: true; value <=> root.comp_attack; value-text: root.comp_attack_text; changed(v) => { root.comp_attack_changed(v); } }
                    LxKnob { label: "RELEASE"; small: true; value <=> root.comp_release; value-text: root.comp_release_text; changed(v) => { root.comp_release_changed(v); } }
                    LxKnob { label: "RATIO"; small: true; value <=> root.comp_character; value-text: root.comp_character_text; changed(v) => { root.comp_character_changed(v); } }
                    LxKnob { label: "MAKEUP"; small: true; value <=> root.comp_makeup; value-text: root.comp_makeup_text; changed(v) => { root.comp_makeup_changed(v); } }
                }
            }

            // GR meter
            VerticalLayout {
                spacing: 4px;
                width: 50px;
                horizontal-stretch: 0;
                alignment: center;
                Text {
                    text: "GR";
                    font-size: Lx.font-xs;
                    color: Lx.text-muted;
                    horizontal-alignment: center;
                }
                LxGrMeter {
                    level: root.gr;
                    label: "";
                    width: 40px;
                }
            }

            // Inflate block
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 0;
                alignment: start;
                Text {
                    text: "INFLATE";
                    font-size: Lx.font-xs;
                    font-weight: 700;
                    color: Lx.amber-hot;
                }
                HorizontalLayout {
                    spacing: 2px;
                    LxKnob { label: "EFFECT"; small: true; value <=> root.inflate_effect; value-text: root.inflate_effect_text; changed(v) => { root.inflate_effect_changed(v); } }
                    LxKnob { label: "CURVE"; small: true; value <=> root.inflate_curve; value-text: root.inflate_curve_text; changed(v) => { root.inflate_curve_changed(v); } }
                }
                HorizontalLayout {
                    spacing: 4px;
                    LxToggleBtn {
                        label: "SPLIT";
                        active <=> root.inflate_band_split;
                        toggled(v) => { root.inflate_band_split_changed(v); }
                    }
                    LxToggleBtn {
                        label: "CLIP";
                        active <=> root.inflate_clip;
                        toggled(v) => { root.inflate_clip_changed(v); }
                    }
                }
            }

            // Fill spacer (room for future ANALYZE etc.)
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
            }

            // Stereo / routing (right)
            VerticalLayout {
                spacing: 2px;
                horizontal-stretch: 0;
                alignment: start;
                Text {
                    text: "STEREO";
                    font-size: Lx.font-xs;
                    font-weight: 700;
                    color: Lx.amber-hot;
                }
                HorizontalLayout {
                    spacing: 4px;
                    LxKnob { label: "PAN"; small: true; value <=> root.pan; value-text: root.pan_text; changed(v) => { root.pan_changed(v); } }
                    LxKnob { label: "WIDTH"; small: true; value <=> root.stereo_width; value-text: root.stereo_width_text; changed(v) => { root.stereo_width_changed(v); } }
                }
            }

            LxDangerBtn {
                label: "RESET";
                clicked => { root.reset_clicked(); }
            }
        }
    }

    // ── VAULT SETUP POPUP ───────────────────────────────────────────────────
    vault_setup_popup := PopupWindow {
        width: 420px;
        height: 150px;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;

        Rectangle {
            background: Lx.panel;
            border-radius: Lx.radius-md;
            border-width: 1px;
            border-color: Lx.steel;

            VerticalLayout {
                padding: Lx.pad-md;
                spacing: Lx.gap-md;

                Text {
                    text: "VAULT PATH";
                    font-size: Lx.font-md;
                    font-weight: 700;
                    color: Lx.amber-hot;
                }

                LxLineEdit {
                    placeholder-text: "/path/to/vault";
                    text <=> root.vault_path;
                    vertical-stretch: 0;
                }

                HorizontalLayout {
                    spacing: Lx.gap-md;

                    LxButton {
                        text: "OK";
                        clicked => {
                            root.vault_path_changed(root.vault_path);
                            vault_setup_popup.close();
                        }
                    }

                    LxButton {
                        text: "CANCEL";
                        clicked => { vault_setup_popup.close(); }
                    }
                }
            }
        }
    }
}
