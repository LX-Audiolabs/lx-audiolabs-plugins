import { Palette } from "std-widgets.slint";
import {
    Lx, LxShellHeader, LxShellBody, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
    LxSection, LxKnob, LxSlider, LxEqBandColumn, LxSegmentedButton, LxToggleBtn, LxButton, LxDangerBtn, LxLineEdit,
    LxSpectrum, LxEqCurve, LxGoniometer, LxLedPeakMeter, LxGrMeter, LxCorrelation, LxCompDisplay,
} from "../../../crates/lx-ui-slint/ui/lx.slint";
import { LxVaultSetupPopup } from "../../../crates/lx-ui-slint/ui/lx-dialogs.slint";

export component MeridianUi inherits Window {
    // --- float params (normalized) + formatted text ---
    in-out property <float> hpf_freq: 0.5; in property <string> hpf_freq_text: ""; in property <float> hpf_freq_default: 0.5;
    callback hpf_freq_changed(float);
    in-out property <float> lpf_freq: 0.5; in property <string> lpf_freq_text: ""; in property <float> lpf_freq_default: 0.5;
    callback lpf_freq_changed(float);

    in-out property <float> bass_gain: 0.5; in property <string> bass_gain_text: ""; in property <float> bass_gain_default: 0.5;
    callback bass_gain_changed(float);
    in-out property <float> lo_mid_gain: 0.5; in property <string> lo_mid_gain_text: ""; in property <float> lo_mid_gain_default: 0.5;
    callback lo_mid_gain_changed(float);
    in-out property <float> mid_gain: 0.5; in property <string> mid_gain_text: ""; in property <float> mid_gain_default: 0.5;
    callback mid_gain_changed(float);
    in-out property <float> high_gain: 0.5; in property <string> high_gain_text: ""; in property <float> high_gain_default: 0.5;
    callback high_gain_changed(float);
    in-out property <float> excite_gain: 0.5; in property <string> excite_gain_text: ""; in property <float> excite_gain_default: 0.5;
    callback excite_gain_changed(float);

    in-out property <float> eq_freq_1: 0.5; in property <string> eq_freq_1_text: ""; in property <float> eq_freq_1_default: 0.5;
    callback eq_freq_1_changed(float);
    in-out property <float> eq_freq_2: 0.5; in property <string> eq_freq_2_text: ""; in property <float> eq_freq_2_default: 0.5;
    callback eq_freq_2_changed(float);
    in-out property <float> eq_freq_3: 0.5; in property <string> eq_freq_3_text: ""; in property <float> eq_freq_3_default: 0.5;
    callback eq_freq_3_changed(float);
    in-out property <float> eq_freq_4: 0.5; in property <string> eq_freq_4_text: ""; in property <float> eq_freq_4_default: 0.5;
    callback eq_freq_4_changed(float);
    in-out property <float> eq_freq_5: 0.5; in property <string> eq_freq_5_text: ""; in property <float> eq_freq_5_default: 0.5;
    callback eq_freq_5_changed(float);

    in-out property <float> tilt_gain: 0.5; in property <string> tilt_gain_text: ""; in property <float> tilt_gain_default: 0.5;
    callback tilt_gain_changed(float);

    in-out property <float> warmth_drive: 0.0; in property <string> warmth_drive_text: ""; in property <float> warmth_drive_default: 0.0;
    callback warmth_drive_changed(float);
    in-out property <float> warmth_mix: 0.0; in property <string> warmth_mix_text: ""; in property <float> warmth_mix_default: 0.0;
    callback warmth_mix_changed(float);

    in-out property <float> excite_amount: 0.0; in property <string> excite_amount_text: ""; in property <float> excite_amount_default: 0.0;
    callback excite_amount_changed(float);
    in-out property <float> excite_blend: 0.0; in property <string> excite_blend_text: ""; in property <float> excite_blend_default: 0.0;
    callback excite_blend_changed(float);
    in-out property <float> excite_freq: 0.5; in property <string> excite_freq_text: ""; in property <float> excite_freq_default: 0.5;
    callback excite_freq_changed(float);

    in-out property <float> comp_threshold: 0.5; in property <string> comp_threshold_text: ""; in property <float> comp_threshold_default: 0.5;
    callback comp_threshold_changed(float);
    in-out property <float> comp_mix: 0.0; in property <string> comp_mix_text: ""; in property <float> comp_mix_default: 0.0;
    callback comp_mix_changed(float);
    in-out property <float> comp_attack: 0.5; in property <string> comp_attack_text: ""; in property <float> comp_attack_default: 0.5;
    callback comp_attack_changed(float);
    in-out property <float> comp_release: 0.5; in property <string> comp_release_text: ""; in property <float> comp_release_default: 0.5;
    callback comp_release_changed(float);
    in-out property <float> comp_character: 0.5; in property <string> comp_character_text: ""; in property <float> comp_character_default: 0.5;
    callback comp_character_changed(float);
    in-out property <float> comp_makeup: 0.0; in property <string> comp_makeup_text: ""; in property <float> comp_makeup_default: 0.0;
    callback comp_makeup_changed(float);

    in-out property <float> inflate_effect: 0.0; in property <string> inflate_effect_text: ""; in property <float> inflate_effect_default: 0.0;
    callback inflate_effect_changed(float);
    in-out property <float> inflate_curve: 0.5; in property <string> inflate_curve_text: ""; in property <float> inflate_curve_default: 0.5;
    callback inflate_curve_changed(float);

    in-out property <float> stereo_width: 0.5; in property <string> stereo_width_text: ""; in property <float> stereo_width_default: 0.5;
    callback stereo_width_changed(float);
    in-out property <float> pan: 0.5; in property <string> pan_text: ""; in property <float> pan_default: 0.5;
    callback pan_changed(float);
    in-out property <float> output_gain: 0.5; in property <string> output_gain_text: ""; in property <float> output_gain_default: 0.5;
    callback output_gain_changed(float);

    // Auto Loud (right bar) — measures ~5s then applies LUFS offset to out gain
    in property <bool> auto_loud_measuring: false;
    callback auto_loud_clicked;

    // --- int params (slope selectors) ---
    in-out property <float> cut_slope: 0.0; callback cut_slope_changed(float);
    in-out property <float> bass_slope: 1.0; callback bass_slope_changed(float);
    in-out property <float> lo_mid_slope: 1.0; callback lo_mid_slope_changed(float);
    in-out property <float> mid_slope: 1.0; callback mid_slope_changed(float);
    in-out property <float> high_slope: 1.0; callback high_slope_changed(float);
    in-out property <float> excite_slope: 1.0; callback excite_slope_changed(float);

    // --- bool params ---
    in-out property <bool> mono_active: false; callback mono_active_changed(bool);
    in-out property <bool> delta_active: false; callback delta_active_changed(bool);
    in-out property <bool> bypass_active: false; callback bypass_active_changed(bool);
    in-out property <bool> inflate_band_split: false; callback inflate_band_split_changed(bool);
    in-out property <bool> inflate_clip: false; callback inflate_clip_changed(bool);

    // --- visualization ---
    in property <string> spectrum_path: "";
    in property <string> curve_cmds: "";
    in property <string> gonio_path: "";
    in property <float> meter_l: 0.0;
    in property <float> meter_r: 0.0;
    in property <float> peak_hold_l: 0.0;
    in property <float> peak_hold_r: 0.0;
    in property <float> gr: 0.0;
    in property <string> comp_peak_text: "";
    in property <string> gr_text: "";
    // Compressor envelope path (110×48 viewBox) for footer mini-display
    in property <string> gr_envelope_cmds: "";
    in property <float> correlation: 0.0;
    in property <float> balance: 0.0;
    in property <string> corr_text: "";
    in property <string> balance_text: "";
    in property <string> peak_l_text: "";
    in property <string> peak_r_text: "";

    // Preset UI state (local for now — vault wiring later)
    in-out property <string> preset_name: "";
    in-out property <string> vault_path: "";
    in property <string> snap_label: "SNAP";

    callback reset_peaks;
    callback snap_clicked;
    callback save_clicked;
    callback vault_path_changed(string);
    callback reset_clicked;

    init => { Palette.color-scheme = ColorScheme.dark; }

    title: "Meridian";
    background: Lx.window;
    // Frozen vault size
    preferred-width: Lx.window-w;
    preferred-height: Lx.window-h;
    min-width: Lx.window-w;
    min-height: Lx.window-h;

    // ═══════════════════════════════════════════════════════════════════════
    // TABLE LAYOUT
    //   ┌──────────────────────────────────────────────────────────────┐
    //   │ HEADER 50px                                                  │
    //   ├──────────┬───────────────────────────────────┬───────────────┤
    //   │ LEFT 180 │ MAIN (fill)                       │ RIGHT 155     │
    //   │          │                                   │               │
    //   ├──────────┴───────────────────────────────────┴───────────────┤
    //   │ FOOTER 110px                                                 │
    //   └──────────────────────────────────────────────────────────────┘
    // ═══════════════════════════════════════════════════════════════════════

    VerticalLayout {
        spacing: 0;

        // ── HEADER ───────────────────────────────────────────────────────
        LxShellHeader {
            plugin-name: "MERIDIAN";
            version: "1.9.7";

            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                LxToggleBtn {
                    label: "MONO";
                    active <=> root.mono_active;
                    toggled(v) => { root.mono_active_changed(v); }
                }
                LxToggleBtn {
                    label: "DELTA";
                    active <=> root.delta_active;
                    toggled(v) => { root.delta_active_changed(v); }
                }
                LxToggleBtn {
                    label: "BYPASS";
                    active <=> root.bypass_active;
                    toggled(v) => { root.bypass_active_changed(v); }
                }
            }
        }

        // ── BODY ─────────────────────────────────────────────────────────
        LxShellBody {
            // ── LEFT BAR: vault / presets ─────────────────────────────
            LxShellLeft {
                title: "VAULT PRESETS";

                LxLineEdit {
                    placeholder-text: "Preset Name...";
                    text <=> root.preset_name;
                    vertical-stretch: 0;
                }

                HorizontalLayout {
                    spacing: Lx.gap-sm;
                    vertical-stretch: 0;

                    LxButton {
                        text: root.snap_label;
                        primary: true;
                        horizontal-stretch: 1;
                        clicked => { root.snap_clicked(); }
                    }

                    LxButton {
                        text: "SAVE";
                        horizontal-stretch: 1;
                        clicked => { root.save_clicked(); }
                    }
                }

                LxButton {
                    text: "VAULT SETUP";
                    vertical-stretch: 0;
                    clicked => { vault_setup_popup.show(); }
                }


                // Preset list placeholder
                Rectangle {
                    vertical-stretch: 1;
                    background: Lx.void;
                    border-radius: Lx.radius-sm;

                    VerticalLayout {
                        padding: 6px;
                        spacing: 4px;
                        alignment: start;

                        Text {
                            text: "── Factory ──";
                            font-size: Lx.font-xs;
                            font-weight: 700;
                            color: Lx.amber;
                        }
                        Text {
                            text: "  (vault wiring soon)";
                            font-size: Lx.font-xs;
                            color: Lx.text-muted;
                        }
                        Text {
                            text: "── User ──";
                            font-size: Lx.font-xs;
                            font-weight: 700;
                            color: Lx.amber;
                        }
                        Text {
                            text: "  (empty)";
                            font-size: Lx.font-xs;
                            color: Lx.text-muted;
                        }
                    }
                }
            }

            // ── MAIN PANEL: Option A — 3× LxSection ──────────────────
            //   1) Tone: Filter / Warmth / Exciter / Tilt (no section title)
            //   2) FFT spectrum + EQ curve (no title, fixed height)
            //   3) 5-band EQ (section title; takes leftover stretch)
            LxShellMain {
                VerticalLayout {
                    spacing: 4px;
                    padding: 0;

                    // ── Card 1: tone groups (module labels stay, no LxSection title)
                    LxSection {
                        show-title: false;
                        vertical-stretch: 0;

                        HorizontalLayout {
                            spacing: 0;
                            alignment: stretch;
                            vertical-stretch: 0;

                            // FILTER
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                padding-left: 4px;
                                padding-right: 4px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "FILTER";
                                    font-size: Lx.font-xs;
                                    font-weight: 700;
                                    color: Lx.amber-hot;
                                    horizontal-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    LxKnob { small: true; label: "LOW CUT"; value <=> root.hpf_freq; value-text: root.hpf_freq_text; default-value: root.hpf_freq_default; changed(v) => { root.hpf_freq_changed(v); } }
                                    LxSegmentedButton {
                                        vertical: true;
                                        choices: ["12 dB", "24 dB"];
                                        index <=> root.cut_slope;
                                        changed(v) => { root.cut_slope_changed(v); }
                                    }
                                    LxKnob { small: true; label: "HIGH CUT"; value <=> root.lpf_freq; value-text: root.lpf_freq_text; default-value: root.lpf_freq_default; changed(v) => { root.lpf_freq_changed(v); } }
                                }
                            }

                            Rectangle { width: 1px; background: Lx.steel; horizontal-stretch: 0; }

                            // WARMTH (saturator)
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                padding-left: 4px;
                                padding-right: 4px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "WARMTH";
                                    font-size: Lx.font-xs;
                                    font-weight: 700;
                                    color: Lx.amber-hot;
                                    horizontal-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    LxKnob { small: true; label: "DRIVE"; value <=> root.warmth_drive; value-text: root.warmth_drive_text; default-value: root.warmth_drive_default; changed(v) => { root.warmth_drive_changed(v); } }
                                    LxKnob { small: true; label: "W/MIX"; value <=> root.warmth_mix; value-text: root.warmth_mix_text; default-value: root.warmth_mix_default; changed(v) => { root.warmth_mix_changed(v); } }
                                }
                            }

                            Rectangle { width: 1px; background: Lx.steel; horizontal-stretch: 0; }

                            // EXCITER
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                padding-left: 4px;
                                padding-right: 4px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "EXCITER";
                                    font-size: Lx.font-xs;
                                    font-weight: 700;
                                    color: Lx.amber-hot;
                                    horizontal-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    LxKnob { small: true; label: "AMT"; value <=> root.excite_amount; value-text: root.excite_amount_text; default-value: root.excite_amount_default; changed(v) => { root.excite_amount_changed(v); } }
                                    LxKnob { small: true; label: "BLEND"; value <=> root.excite_blend; value-text: root.excite_blend_text; default-value: root.excite_blend_default; changed(v) => { root.excite_blend_changed(v); } }
                                    LxKnob { small: true; label: "FREQ"; value <=> root.excite_freq; value-text: root.excite_freq_text; default-value: root.excite_freq_default; changed(v) => { root.excite_freq_changed(v); } }
                                }
                            }

                            Rectangle { width: 1px; background: Lx.steel; horizontal-stretch: 0; }

                            // TILT
                            VerticalLayout {
                                spacing: 2px;
                                alignment: start;
                                padding-left: 4px;
                                padding-right: 4px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "TILT EQ";
                                    font-size: Lx.font-xs;
                                    font-weight: 700;
                                    color: Lx.amber-hot;
                                    horizontal-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: center;
                                    LxKnob { small: true; label: "SLOPE"; value <=> root.tilt_gain; value-text: root.tilt_gain_text; default-value: root.tilt_gain_default; changed(v) => { root.tilt_gain_changed(v); } }
                                }
                            }
                        }
                    }

                    // ── Card 2: FFT — no title, fixed height (no stretch hog)
                    LxSection {
                        show-title: false;
                        vertical-stretch: 0;

                        Rectangle {
                            min-height: 120px;
                            preferred-height: 140px;
                            max-height: 150px;
                            vertical-stretch: 0;
                            background: Lx.void;
                            border-radius: Lx.radius-sm;
                            clip: true;

                            // Spectrum Y = −70…−18 dB (vizia SpectrumConfig default).
                            // EQ curve Y = ±24 dB (separate overlay axis, labels-right).
                            LxSpectrum {
                                width: 100%;
                                height: 100%;
                                commands: root.spectrum_path;
                                path-w: 620;
                                path-h: 140;
                                // Stroke only — fill shading hides EQ curve overlay.
                                fill-color: transparent;
                                stroke-color: #19e6b3;
                                db-top: "-18";
                                db-mid: "-44";
                                db-bot: "-70";
                                freq-lo: "20 Hz";
                                freq-mid: "1 kHz";
                                freq-hi: "20 kHz";
                            }

                            LxEqCurve {
                                width: 100%;
                                height: 100%;
                                commands: root.curve_cmds;
                                path-w: 620;
                                path-h: 140;
                                surface: transparent;
                                show-grid: false;
                                show-labels: true;
                                labels-right: true;
                                db-top: "+24";
                                db-mid: "0";
                                db-bot: "-24";
                            }
                        }
                    }

                    // ── Card 3: 5-band EQ (title + leftover vertical space; −20px vs FFT gain)
                    LxSection {
                        title: "EQ";
                        show-title: true;
                        vertical-stretch: 1;
                        min-height: 120px;

                        HorizontalLayout {
                            spacing: 4px;
                            alignment: stretch;
                            vertical-stretch: 1;
                            min-width: 0px;
                            horizontal-stretch: 1;

                            LxEqBandColumn {
                                title: "Sub";
                                subtitle: "LO SHELF";
                                q-label: "Shelf Slope";
                                vertical-stretch: 1;
                                gain <=> root.bass_gain;
                                gain-text: root.bass_gain_text;
                                gain-default: root.bass_gain_default;
                                gain_changed(v) => { root.bass_gain_changed(v); }
                                freq <=> root.eq_freq_1;
                                freq-text: root.eq_freq_1_text;
                                freq-default: root.eq_freq_1_default;
                                freq_changed(v) => { root.eq_freq_1_changed(v); }
                                slope <=> root.bass_slope;
                                slope_changed(v) => { root.bass_slope_changed(v); }
                            }
                            LxEqBandColumn {
                                title: "Bass";
                                subtitle: "LO-MID";
                                q-label: "Filter Q";
                                vertical-stretch: 1;
                                gain <=> root.lo_mid_gain;
                                gain-text: root.lo_mid_gain_text;
                                gain-default: root.lo_mid_gain_default;
                                gain_changed(v) => { root.lo_mid_gain_changed(v); }
                                freq <=> root.eq_freq_2;
                                freq-text: root.eq_freq_2_text;
                                freq-default: root.eq_freq_2_default;
                                freq_changed(v) => { root.eq_freq_2_changed(v); }
                                slope <=> root.lo_mid_slope;
                                slope_changed(v) => { root.lo_mid_slope_changed(v); }
                            }
                            LxEqBandColumn {
                                title: "Mid";
                                subtitle: "MID";
                                q-label: "Filter Q";
                                vertical-stretch: 1;
                                gain <=> root.mid_gain;
                                gain-text: root.mid_gain_text;
                                gain-default: root.mid_gain_default;
                                gain_changed(v) => { root.mid_gain_changed(v); }
                                freq <=> root.eq_freq_3;
                                freq-text: root.eq_freq_3_text;
                                freq-default: root.eq_freq_3_default;
                                freq_changed(v) => { root.eq_freq_3_changed(v); }
                                slope <=> root.mid_slope;
                                slope_changed(v) => { root.mid_slope_changed(v); }
                            }
                            LxEqBandColumn {
                                title: "Presence";
                                subtitle: "HI-MID";
                                q-label: "Filter Q";
                                vertical-stretch: 1;
                                gain <=> root.high_gain;
                                gain-text: root.high_gain_text;
                                gain-default: root.high_gain_default;
                                gain_changed(v) => { root.high_gain_changed(v); }
                                freq <=> root.eq_freq_4;
                                freq-text: root.eq_freq_4_text;
                                freq-default: root.eq_freq_4_default;
                                freq_changed(v) => { root.eq_freq_4_changed(v); }
                                slope <=> root.high_slope;
                                slope_changed(v) => { root.high_slope_changed(v); }
                            }
                            LxEqBandColumn {
                                title: "Air";
                                subtitle: "HI SHELF";
                                q-label: "Shelf Slope";
                                vertical-stretch: 1;
                                gain <=> root.excite_gain;
                                gain-text: root.excite_gain_text;
                                gain-default: root.excite_gain_default;
                                gain_changed(v) => { root.excite_gain_changed(v); }
                                freq <=> root.eq_freq_5;
                                freq-text: root.eq_freq_5_text;
                                freq-default: root.eq_freq_5_default;
                                freq_changed(v) => { root.eq_freq_5_changed(v); }
                                slope <=> root.excite_slope;
                                slope_changed(v) => { root.excite_slope_changed(v); }
                            }
                        }
                    }
                }
            }

            // ── RIGHT BAR: output gain + meters + gonio ───────────────
            LxShellRight {
                title: "OUTPUT LEVEL";

                // Knob like all others: label above, dB value below; AUTO LOUD beside
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    vertical-stretch: 0;

                    LxKnob {
                        label: "OUT GAIN";
                        value <=> root.output_gain;
                        value-text: root.output_gain_text;
                        default-value: root.output_gain_default;
                        changed(v) => { root.output_gain_changed(v); }
                        horizontal-stretch: 0;
                    }

                    LxButton {
                        text: root.auto_loud_measuring ? "MEAS…" : "AUTO LOUD";
                        primary: root.auto_loud_measuring;
                        min-width: 72px;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        clicked => { root.auto_loud_clicked(); }
                    }
                }

                Text {
                    text: "OUTPUT PEAK";
                    font-size: Lx.font-xs;
                    color: Lx.text-muted;
                    vertical-stretch: 0;
                }

                LxLedPeakMeter {
                    height: 160px;
                    vertical-stretch: 0;
                    level-l: root.meter_l;
                    level-r: root.meter_r;
                    hold-l: root.peak_hold_l;
                    hold-r: root.peak_hold_r;
                    reset-peaks => { root.reset_peaks(); }
                }

                // Peak readouts
                HorizontalLayout {
                    spacing: 4px;
                    vertical-stretch: 0;
                    Text {
                        text: root.peak_l_text != "" ? root.peak_l_text : "L";
                        font-size: Lx.font-sm;
                        color: Lx.amber;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "dB";
                        font-size: Lx.font-xs;
                        color: Lx.text-muted;
                    }
                    Text {
                        text: root.peak_r_text != "" ? root.peak_r_text : "R";
                        font-size: Lx.font-sm;
                        color: Lx.amber;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }

                LxCorrelation {
                    correlation: root.correlation;
                    text: root.corr_text;
                    vertical-stretch: 0;
                }

                // Spacer pushes gonio to bottom (matches Vizia)
                Rectangle {
                    vertical-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "GONIOMETER";
                    font-size: Lx.font-xs;
                    color: Lx.text-muted;
                    vertical-stretch: 0;
                }

                LxGoniometer {
                    height: Lx.gonio-h;
                    vertical-stretch: 0;
                    commands: root.gonio_path;
                    path-w: 139;
                    path-h: 139;
                }
            }
        }

        // ── FOOTER: 3 cards (COMP | INFLATE | STEREO) + bare RESET ──
        LxShellFooter {
            // COMPRESSOR card
            LxSection {
                title: "COMPRESSOR";
                horizontal-stretch: 3;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    LxKnob { label: "THRESH"; small: true; value <=> root.comp_threshold; value-text: root.comp_threshold_text; default-value: root.comp_threshold_default; changed(v) => { root.comp_threshold_changed(v); } }
                    LxKnob { label: "MIX"; small: true; value <=> root.comp_mix; value-text: root.comp_mix_text; default-value: root.comp_mix_default; changed(v) => { root.comp_mix_changed(v); } }
                    LxKnob { label: "ATTACK"; small: true; value <=> root.comp_attack; value-text: root.comp_attack_text; default-value: root.comp_attack_default; changed(v) => { root.comp_attack_changed(v); } }
                    LxKnob { label: "RELEASE"; small: true; value <=> root.comp_release; value-text: root.comp_release_text; default-value: root.comp_release_default; changed(v) => { root.comp_release_changed(v); } }
                    LxKnob { label: "RATIO"; small: true; value <=> root.comp_character; value-text: root.comp_character_text; default-value: root.comp_character_default; changed(v) => { root.comp_character_changed(v); } }
                    LxKnob { label: "MAKEUP"; small: true; value <=> root.comp_makeup; value-text: root.comp_makeup_text; default-value: root.comp_makeup_default; changed(v) => { root.comp_makeup_changed(v); } }
                    LxCompDisplay {
                        pk-text: root.comp_peak_text;
                        gr-text: root.gr_text;
                        gr: root.gr;
                        envelope-cmds: root.gr_envelope_cmds;
                    }
                }
            }

            // INFLATE card
            LxSection {
                title: "INFLATE";
                horizontal-stretch: 1;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    LxKnob { label: "EFFECT"; small: true; value <=> root.inflate_effect; value-text: root.inflate_effect_text; default-value: root.inflate_effect_default; changed(v) => { root.inflate_effect_changed(v); } }
                    LxKnob { label: "CURVE"; small: true; value <=> root.inflate_curve; value-text: root.inflate_curve_text; default-value: root.inflate_curve_default; changed(v) => { root.inflate_curve_changed(v); } }
                    VerticalLayout {
                        spacing: 2px;
                        alignment: center;
                        horizontal-stretch: 0;
                        LxToggleBtn {
                            label: "SPLIT";
                            small: true;
                            active <=> root.inflate_band_split;
                            toggled(v) => { root.inflate_band_split_changed(v); }
                        }
                        LxToggleBtn {
                            label: "CLIP";
                            small: true;
                            active <=> root.inflate_clip;
                            toggled(v) => { root.inflate_clip_changed(v); }
                        }
                    }
                }
            }

            // STEREO card
            LxSection {
                title: "STEREO";
                horizontal-stretch: 1;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 4px;
                    alignment: center;
                    LxKnob { label: "PAN"; small: true; value <=> root.pan; value-text: root.pan_text; default-value: root.pan_default; changed(v) => { root.pan_changed(v); } }
                    LxKnob { label: "WIDTH"; small: true; value <=> root.stereo_width; value-text: root.stereo_width_text; default-value: root.stereo_width_default; changed(v) => { root.stereo_width_changed(v); } }
                }
            }

            // RESET — bare, no card
            VerticalLayout {
                spacing: 0;
                horizontal-stretch: 0;
                alignment: center;
                min-width: 72px;

                LxDangerBtn {
                    label: "RESET";
                    clicked => { root.reset_clicked(); }
                }
            }
        }
    }

    // Full-window dimmer keeps dialog above Path layers (spectrum/EQ).
    vault_setup_popup := LxVaultSetupPopup {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        path <=> root.vault_path;
        plugin-label: "Meridian";
        saved(p) => { root.vault_path_changed(p); }
    }
}
