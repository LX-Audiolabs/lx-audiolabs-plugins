import {
    Lx, LxShellHeader, LxShellBody, LxShellMain, LxLineEdit, LxSelectTrigger,
} from "../../../crates/lx-ui-slint/ui/lx.slint";

export component LucentRelayUi inherits Window {
    preferred-width: 260px;
    preferred-height: 160px;
    title: "Lucent Relay";
    background: Lx.window;

    in-out property <string> relay_name: "";
    callback relay_name_changed(string);

    in property <int> target_index: 0;
    in property <[string]> target_names: ["(broadcast)"];
    callback target_selected(int);

    in property <string> status_text: "—";
    in property <bool> connected: false;
    in property <string> version: "1.0.0";

    VerticalLayout {
        padding: 0;
        spacing: 0;

        LxShellHeader {
            plugin-name: "Lucent-Relay";
            version: root.version;
        }

        LxShellBody {
            LxShellMain {
                VerticalLayout {
                    padding: Lx.pad-md;
                    spacing: Lx.gap-md;

                    HorizontalLayout {
                        spacing: Lx.gap-sm;
                        alignment: center;
                        Text {
                            text: "Name";
                            color: Lx.text-secondary;
                            font-size: Lx.font-sm;
                            vertical-alignment: center;
                            min-width: 48px;
                        }
                        LxLineEdit {
                            text <=> root.relay_name;
                            light: true;
                            accepted => { root.relay_name_changed(self.text); }
                            committed => { root.relay_name_changed(self.text); }
                        }
                    }

                    HorizontalLayout {
                        spacing: Lx.gap-sm;
                        alignment: center;
                        Text {
                            text: "Target";
                            color: Lx.text-secondary;
                            font-size: Lx.font-sm;
                            vertical-alignment: center;
                            min-width: 48px;
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            height: Lx.button-h;
                            background: transparent;
                            target_dd := LxSelectTrigger {
                                trigger-width: parent.width;
                                text: root.target_index >= 0 && root.target_index < root.target_names.length
                                    ? root.target_names[root.target_index] : "(broadcast)";
                                clicked => { target_popup.show(); }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Lx.gap-sm;
                        alignment: center;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: root.connected ? Lx.amber : Lx.text-secondary;
                        }
                        Text {
                            text: root.status_text;
                            color: Lx.text-secondary;
                            font-size: Lx.font-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }

    // ── Target list popup — anchored under the dropdown trigger (Aether pattern) ──
    target_popup := PopupWindow {
        width: max(146px, target_dd.width);
        x: target_dd.absolute-position.x;
        y: target_dd.absolute-position.y + target_dd.height + 2px;
        height: min(160px, 8px + root.target_names.length * 22px);

        Rectangle {
            background: #ffffff;
            border-radius: Lx.radius-sm;
            border-width: 1px;
            border-color: #8c8c8c;
            clip: true;

            Flickable {
                width: 100%;
                height: 100%;
                viewport-height: root.target_names.length * 22px;

                VerticalLayout {
                    alignment: start;
                    spacing: 0px;

                    for name[i] in root.target_names: Rectangle {
                        height: 22px;
                        vertical-stretch: 0;
                        background: row_ta.has-hover ? #f0f0f0 : #ffffff;

                        HorizontalLayout {
                            padding-left: Lx.pad-sm;
                            Text {
                                text: name;
                                font-size: Lx.font-md;
                                color: #282828;
                                vertical-alignment: center;
                            }
                        }

                        row_ta := TouchArea {
                            clicked => {
                                root.target_selected(i);
                                target_popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
