import { Palette } from "std-widgets.slint";
import {
    Lx, LxShellHeader, LxShellBody, LxShellLeft, LxShellMain, LxShellRight,
    LxSection, LxKnob, LxToggleBtn, LxButton, LxDangerBtn,
    LxSpectrum, LxGoniometer, LxLedPeakMeter, LxCorrelation,
} from "../../../crates/lx-ui-slint/ui/lx.slint";
import { LxVaultSetupOverlay } from "../../../crates/lx-ui-slint/ui/lx-dialogs.slint";

/// Relay overlay curve: Rust-built path + palette color (cycles by active idx).
export struct RelayCurve { cmds: string, col: color }
/// Resonance marker: Rust-built path (line + diamond) + per-marker alpha.
export struct ResMarker { cmds: string, a: float }

/// Lucent — FFT spectrum analyser / masking.
/// Compact shell (no footer / no OUT GAIN): 940 × 500 — right bar is
/// Peak → correlation → goniometer only (Meridian order, tight pack).
export component LucentUi inherits Window {
    // Bundled font (lx.slint) — fixed metrics on every OS.
    default-font-family: Lx.font-family;

    init => { Palette.color-scheme = ColorScheme.dark; }

    title: "Lucent";
    background: Lx.window;
    // 50px under vault 990 so main pit width matches spectrum path better.
    preferred-width: 940px;
    // Not Lx.window-h (670): Lucent has no footer; tight right-bar stack.
    preferred-height: 500px;
    min-width: 940px;
    min-height: 500px;

    in property <string> version: "1.2.0";

    // Product UI zoom (75/100/125%) — logo menu in LxShellHeader
    in-out property <int> ui_zoom_percent: 100;
    callback ui_zoom_changed(int);

    // Identity
    in-out property <string> display_name: "";
    callback display_name_changed(string);

    // Analyze (0 = own, 1 = hybrid/own+relays, 2 = relay-only)
    in-out property <float> analyze_mode: 0.0;
    callback analyze_mode_changed(float);
    in-out property <bool> resonance_active: true;
    callback resonance_active_changed(bool);
    in-out property <bool> masking_active: true;
    callback masking_active_changed(bool);
    in-out property <bool> bypass_active: false;
    callback bypass_active_changed(bool);
    in-out property <float> sensitivity: 0.5;
    in property <string> sensitivity_text: "50%";
    callback sensitivity_changed(float);

    // SPAN-like display: 1/3-oct smooth toggle + session SNAP
    in-out property <bool> spectrum_smooth: false;
    callback spectrum_smooth_changed(bool);
    callback snap_clicked();
    in property <string> snap_label: "SNAP";
    in property <string> snap_status: "";
    callback reset_peaks();

    // Relay bar + curves (fed from the process-published registry)
    in property <[string]> relay_names: [];
    in property <[bool]> relay_actives: [];
    callback relay_toggled(float);
    in property <[RelayCurve]> relay_curves: [];

    // Viz / telemetry
    in property <string> spectrum_cmds: "";
    in property <string> mask_cmds: "";
    in property <[ResMarker]> res_markers: [];
    in property <string> resonance_text: "No resonances detected";
    in property <string> masking_text: "No masking detected";
    in property <string> status_line: "";
    in property <float> meter_l: 0.0;
    in property <float> meter_r: 0.0;
    in property <float> hold_l: 0.0;
    in property <float> hold_r: 0.0;
    in property <string> peak_l_text: "";
    in property <string> peak_r_text: "";
    in property <float> balance: 0.0;
    in property <float> correlation: 0.0;
    in property <string> corr_text: "";
    in property <string> gonio_path: "";

    // Vault setup overlay (draft path pattern — see lx-dialogs.slint)
    in-out property <string> vault_path: "";
    in-out property <bool> vault_setup_open: false;
    in-out property <string> vault_setup_path: "";
    callback vault_path_changed(string);
    callback vault_paste_requested();
    in property <string> vault_paste_status: "";

    VerticalLayout {
        spacing: 0;

        // ── HEADER ───────────────────────────────────────────────────────
        // Brand left | instance name center (layout) | mode/RESET/BYPASS right.
        LxShellHeader {
            plugin-name: "Lucent";
            version: root.version;
            ui-zoom-percent <=> root.ui_zoom_percent;
            ui-zoom-changed(p) => { root.ui_zoom_changed(p); }
            show-instance-name: true;
            instance-name <=> root.display_name;
            instance-placeholder: "Instance name";
            instance-field-width: 170px;
            instance-name-changed(t) => { root.display_name_changed(t); };

            // Vizia labels + cycle: HYBRID→STANDALONE→RELAY→HYBRID.
            // Fixed width = STANDALONE (Vizia 110px) so header doesn't jump.
            LxButton {
                text: root.analyze_mode < 0.5 ? "STANDALONE"
                    : (root.analyze_mode < 1.5 ? "HYBRID" : "RELAY");
                horizontal-stretch: 0;
                min-width: 110px;
                preferred-width: 110px;
                max-width: 110px;
                clicked => {
                    // 1→0→2→1 (not linear 0→1→2)
                    root.analyze_mode = root.analyze_mode >= 0.5 && root.analyze_mode < 1.5
                        ? 0.0
                        : (root.analyze_mode < 0.5 ? 2.0 : 1.0);
                    root.analyze_mode_changed(root.analyze_mode);
                }
            }

            Rectangle { width: 6px; background: transparent; }

            LxDangerBtn {
                label: "RESET";
                clicked => { root.reset_peaks(); }
            }
            LxToggleBtn {
                label: "BYPASS";
                active <=> root.bypass_active;
                toggled(v) => { root.bypass_active_changed(v); }
            }
        }

        // ── BODY ─────────────────────────────────────────────────────────
        LxShellBody {
            // ── LEFT BAR: snapshot / vault ────────────────────────────
            LxShellLeft {
                LxSection {
                    title: "SNAPSHOT";
                    vertical-stretch: 0;

                    LxButton {
                        text: root.snap_label;
                        primary: true;
                        clicked => { root.snap_clicked(); }
                    }
                    LxButton {
                        text: "VAULT SETUP";
                        clicked => {
                            root.vault_setup_path = root.vault_path;
                            root.vault_setup_open = true;
                        }
                    }
                    if root.snap_status != "": Text {
                        text: root.snap_status;
                        color: Lx.amber;
                        font-size: Lx.font-xs;
                        wrap: word-wrap;
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }
            }

            // ── MAIN: relay bar + spectrum pit + analyzer panels ──────
            LxShellMain {
                // Relay toggle bar — above FFT (not left sidebar).
                LxSection {
                    title: "RELAYS";
                    vertical-stretch: 0;

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;

                        Text {
                            vertical-alignment: center;
                            text: root.relay_names.length == 0
                                ? "No relays online"
                                : root.relay_names.length == 1
                                    ? "1 relay online"
                                    : root.relay_names.length + " relays online";
                            color: root.relay_names.length > 0 ? Lx.green : Lx.text-muted;
                            font-size: Lx.font-sm;
                        }
                        if root.relay_names.length == 0: Text {
                            vertical-alignment: center;
                            text: "— send a relay from another LX plugin —";
                            color: Lx.text-dim;
                            font-size: Lx.font-xs;
                        }
                        for name[idx] in root.relay_names: LxToggleBtn {
                            small: true;
                            label: name;
                            active: root.relay_actives[idx];
                            toggled(v) => { root.relay_toggled(idx); }
                        }
                    }
                }

                // Spectrum pit: own curve + fill, relay curves, masking bars,
                // resonance markers (all path-driven from Rust).
                // Hover: log-axis read cursor (vertical bar + Hz/kHz) — pure UI,
                // same 20 Hz…20 kHz map as Rust log_x.
                LxSection {
                    show-title: false;
                    vertical-stretch: 1;

                    pit := Rectangle {
                        background: Lx.void;
                        border-radius: Lx.radius-sm;
                        clip: true;

                        // Log-x invert: f = 20 * (20000/20)^t = 20 * 1000^t
                        property <float> hover-t: pit_ta.has-hover && pit.width > 0px
                            ? (pit_ta.mouse-x / pit.width).clamp(0.0, 1.0)
                            : 0.0;
                        property <float> hover-hz: 20.0 * Math.pow(1000.0, hover-t);
                        property <string> hover-freq-text: hover-hz < 1000.0
                            ? Math.round(hover-hz) + " Hz"
                            : (hover-hz < 10000.0
                                ? (Math.floor(hover-hz / 100.0) / 10.0) + " kHz"
                                : Math.round(hover-hz / 1000.0) + " kHz");

                        LxSpectrum {
                            width: 100%;
                            height: 100%;
                            commands: root.spectrum_cmds;
                            path-w: 620;
                            path-h: 300;
                            fill: @linear-gradient(180deg, #19e6b344 0%, #19e6b300 100%);
                            stroke-color: #19e6b3;
                            stroke-width: 1.5px;
                            db-top: "-18 dB";
                            db-mid: "-48";
                            db-bot: "-78";
                            freq-lo: "20 Hz";
                            freq-mid: "1 kHz";
                            freq-hi: "20 kHz";
                        }

                        for r in root.relay_curves: Path {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 620;
                            viewbox-height: 300;
                            fit: ImageFit.fill;
                            commands: r.cmds;
                            stroke: r.col;
                            stroke-width: 1px;
                            fill: transparent;
                        }

                        if root.mask_cmds != "": Path {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 620;
                            viewbox-height: 300;
                            fit: ImageFit.fill;
                            commands: root.mask_cmds;
                            fill: #e0454533;
                            stroke: Lx.crimson;
                            stroke-width: 1px;
                        }

                        for m in root.res_markers: Path {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 620;
                            viewbox-height: 300;
                            fit: ImageFit.fill;
                            commands: m.cmds;
                            stroke: Lx.amber.with-alpha(m.a);
                            stroke-width: 1px;
                            fill: Lx.amber.with-alpha(m.a);
                        }

                        // Full-pit hover hit target (under SMOOTH so toggle stays clickable).
                        pit_ta := TouchArea {
                            width: 100%;
                            height: 100%;
                            mouse-cursor: MouseCursor.crosshair;
                        }

                        if pit_ta.has-hover: Rectangle {
                            x: pit_ta.mouse-x;
                            y: 0;
                            width: 1px;
                            height: 100%;
                            background: #ffffff88;
                        }

                        // Freq readout: bottom of bar (top collides with SMOOTH).
                        // Flip left near right edge; sit above the static freq labels.
                        if pit_ta.has-hover: Rectangle {
                            x: (pit_ta.mouse-x + 64px > pit.width)
                                ? pit_ta.mouse-x - 58px
                                : pit_ta.mouse-x + 6px;
                            y: pit.height - 32px;
                            width: 52px;
                            height: 16px;
                            background: #000000aa;
                            border-radius: 2px;
                            Text {
                                width: 100%;
                                height: 100%;
                                text: pit.hover-freq-text;
                                font-size: Lx.font-xs;
                                font-weight: 600;
                                color: Lx.text;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Display smoothing toggle — sits left of the dB labels.
                        // Explicit width: positioned (no layout), min-width 36px
                        // would clip the 6-char label. Default OFF (Meridian ON).
                        // Drawn last → above hover TA (still clickable).
                        LxToggleBtn {
                            x: parent.width - 100px;
                            y: 4px;
                            width: 46px;
                            label: "SMOOTH";
                            small: true;
                            active <=> root.spectrum_smooth;
                            toggled(v) => { root.spectrum_smooth_changed(v); }
                        }
                    }
                }

                // Analyzer panels: resonance / masking / sensitivity.
                // Res+Mask: equal stretch (min-width 0 + same preferred base) so
                // live top-5 lines do not steal width / jump the layout.
                // Toggle sits in title row (small); body text clips in fixed height.
                HorizontalLayout {
                    spacing: Lx.gap-sm;
                    vertical-stretch: 0;

                    LxSection {
                        show-title: false;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        vertical-stretch: 0;
                        min-height: 130px;
                        preferred-height: 130px;
                        max-height: 130px;
                        clip: true;

                        VerticalLayout {
                            spacing: 4px;
                            min-width: 0px;

                            HorizontalLayout {
                                spacing: Lx.gap-sm;
                                vertical-stretch: 0;
                                Text {
                                    text: "RESONANCE";
                                    font-size: Lx.font-xs;
                                    font-weight: 700;
                                    color: Lx.amber;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    overflow: elide;
                                }
                                LxToggleBtn {
                                    small: true;
                                    width: 36px;
                                    horizontal-stretch: 0;
                                    label: root.resonance_active ? "ON" : "OFF";
                                    active <=> root.resonance_active;
                                    toggled(v) => { root.resonance_active_changed(v); }
                                }
                            }
                            // Fixed body: content swaps every ~500 ms — no reflow.
                            Rectangle {
                                vertical-stretch: 1;
                                min-width: 0px;
                                horizontal-stretch: 1;
                                clip: true;
                                background: transparent;
                                Text {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.resonance_text;
                                    font-size: Lx.font-sm;
                                    color: Lx.text-secondary;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    vertical-alignment: top;
                                }
                            }
                        }
                    }

                    LxSection {
                        show-title: false;
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        vertical-stretch: 0;
                        min-height: 130px;
                        preferred-height: 130px;
                        max-height: 130px;
                        clip: true;

                        VerticalLayout {
                            spacing: 4px;
                            min-width: 0px;

                            HorizontalLayout {
                                spacing: Lx.gap-sm;
                                vertical-stretch: 0;
                                Text {
                                    text: "MASKING";
                                    font-size: Lx.font-xs;
                                    font-weight: 700;
                                    color: Lx.crimson;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    overflow: elide;
                                }
                                // Own: no masking (Vizia grey OFF). Param kept for Both/Relay.
                                // Always one small toggle so header row width stays stable.
                                if root.analyze_mode < 0.5: LxToggleBtn {
                                    small: true;
                                    width: 36px;
                                    horizontal-stretch: 0;
                                    danger: true;
                                    enabled: false;
                                    label: "OFF";
                                    active: false;
                                }
                                if root.analyze_mode >= 0.5: LxToggleBtn {
                                    small: true;
                                    width: 36px;
                                    horizontal-stretch: 0;
                                    danger: true;
                                    label: root.masking_active ? "ON" : "OFF";
                                    active <=> root.masking_active;
                                    toggled(v) => { root.masking_active_changed(v); }
                                }
                            }
                            Rectangle {
                                vertical-stretch: 1;
                                min-width: 0px;
                                horizontal-stretch: 1;
                                clip: true;
                                background: transparent;
                                Text {
                                    x: 0;
                                    y: 0;
                                    width: parent.width;
                                    height: parent.height;
                                    text: root.masking_text;
                                    font-size: Lx.font-sm;
                                    color: Lx.text-secondary;
                                    wrap: word-wrap;
                                    overflow: elide;
                                    vertical-alignment: top;
                                }
                            }
                        }
                    }

                    LxSection {
                        title: "SENSITIVITY";
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        min-height: 130px;
                        preferred-height: 130px;
                        max-height: 130px;

                        // Cross-axis center — LxSection body is left-pin VerticalLayout.
                        HorizontalLayout {
                            alignment: center;
                            LxKnob {
                                label: "";
                                value <=> root.sensitivity;
                                value-text: root.sensitivity_text;
                                changed(v) => { root.sensitivity_changed(v); }
                            }
                        }
                    }
                }
            }

            // ── RIGHT BAR: Peak → correlation → gonio (Meridian order) ─
            // No OUT GAIN / no footer — window height is sized so this
            // stack fills the column without a big empty spacer.
            LxShellRight {
                title: "OUTPUT LEVEL";

                Text {
                    text: "OUTPUT PEAK";
                    font-size: Lx.font-xs;
                    color: Lx.text-muted;
                    vertical-stretch: 0;
                }

                LxLedPeakMeter {
                    height: 160px;
                    vertical-stretch: 0;
                    level-l: root.meter_l;
                    level-r: root.meter_r;
                    hold-l: root.hold_l;
                    hold-r: root.hold_r;
                    balance: root.balance;
                    reset-peaks => { root.reset_peaks(); }
                }

                // Peak-hold readouts — click resets (DAW-style).
                TouchArea {
                    vertical-stretch: 0;
                    clicked => { root.reset_peaks(); }
                    HorizontalLayout {
                        spacing: 4px;
                        Text {
                            text: root.peak_l_text != "" ? root.peak_l_text : "L";
                            font-size: Lx.font-sm;
                            color: Lx.amber;
                            horizontal-stretch: 1;
                        }
                        Text {
                            text: "dB";
                            font-size: Lx.font-xs;
                            color: Lx.text-muted;
                        }
                        Text {
                            text: root.peak_r_text != "" ? root.peak_r_text : "R";
                            font-size: Lx.font-sm;
                            color: Lx.amber;
                            horizontal-stretch: 1;
                            horizontal-alignment: right;
                        }
                    }
                }

                LxCorrelation {
                    correlation: root.correlation;
                    text: root.corr_text;
                    vertical-stretch: 0;
                }

                Text {
                    text: "GONIOMETER";
                    font-size: Lx.font-xs;
                    color: Lx.text-muted;
                    vertical-stretch: 0;
                }

                LxGoniometer {
                    height: Lx.gonio-h;
                    vertical-stretch: 0;
                    commands: root.gonio_path;
                    path-w: 139;
                    path-h: 139;
                }
            }
        }
    }

    // Full-window overlay last in tree → above Path layers.
    vault_setup := LxVaultSetupOverlay {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        open <=> root.vault_setup_open;
        // Two-way draft only — seed on SETUP click; SAVE commits to vault_path.
        path <=> root.vault_setup_path;
        plugin-label: "Lucent";
        paste-status: root.vault_paste_status;
        paste-requested => { root.vault_paste_requested(); }
        saved(p) => {
            root.vault_path = p;
            root.vault_path_changed(p);
        }
    }
}
