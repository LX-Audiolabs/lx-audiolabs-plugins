import {
    Lx, LxLineEdit, LxSelectTrigger,
} from "../../../crates/lx-ui-slint/ui/lx.slint";

/// Lucent-Relay — compact sender. Dark LX chrome, form controls pinned left.
export component LucentRelayUi inherits Window {
    // Wider than Vizia 260 so Name field is actually usable.
    preferred-width: 300px;
    preferred-height: 160px;
    min-width: 300px;
    min-height: 160px;
    max-width: 300px;
    max-height: 160px;
    title: "Lucent Relay";
    background: Lx.window;

    in-out property <string> relay_name: "";
    callback relay_name_changed(string);

    in property <int> target_index: 0;
    in property <[string]> target_names: ["(broadcast)"];
    callback target_selected(int);

    in property <string> status_text: "—";
    in property <bool> connected: false;
    in property <string> version: "1.1.0";

    VerticalLayout {
        spacing: 4px;
        padding: 0;

        // ── Header — same brand chrome as LxShellHeader (compact height) ──
        Rectangle {
            height: 40px;
            vertical-stretch: 0;
            background: @linear-gradient(180deg, Lx.section 0%, Lx.window 70%, Lx.void 100%);

            HorizontalLayout {
                width: 100%;
                height: 100%;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: start;

                Text {
                    text: "LX";
                    font-size: 18px;
                    font-weight: 800;
                    color: Lx.amber;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Text {
                    text: "AUDIOLABS";
                    font-size: 16px;
                    font-weight: 700;
                    color: Lx.text;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }

                Rectangle { width: 10px; background: transparent; }
                Rectangle {
                    width: 1px;
                    height: 24px;
                    background: #2e3838;
                    vertical-stretch: 0;
                }
                Rectangle { width: 10px; background: transparent; }

                // Plugin name + version stack (same tokens as LxShellHeader)
                VerticalLayout {
                    spacing: 0;
                    alignment: center;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;

                    Text {
                        text: "Lucent-Relay";
                        font-size: 13px;
                        font-weight: 700;
                        color: #ffa64d;
                    }
                    Text {
                        text: "v" + root.version;
                        font-size: 10px;
                        color: #808080;
                    }
                }
            }

            // Bottom hairline + amber rail (shell header parity)
            Rectangle {
                y: parent.height - 1px;
                width: 100%;
                height: 1px;
                background: Lx.edge-dark;
            }
            Rectangle {
                y: parent.height - 2px;
                width: 100%;
                height: 1px;
                background: #ff731a33;
            }
        }

        // ── Name — same left-pin pattern as Target, wider field ──
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            alignment: start;
            vertical-stretch: 0;
            height: 32px;

            Text {
                text: "Name";
                color: Lx.text-muted;
                font-size: Lx.font-sm;
                vertical-alignment: center;
                horizontal-stretch: 0;
                min-width: 44px;
                height: 100%;
            }
            LxLineEdit {
                text <=> root.relay_name;
                placeholder-text: "Relay name";
                field-width: 230px;
                // Live keystrokes so Lucent relay button renames without blur wait.
                edited(t) => { root.relay_name_changed(t); }
                accepted(t) => { root.relay_name_changed(t); }
                committed(t) => { root.relay_name_changed(t); }
            }
        }

        // ── Target — label left, fixed trigger pinned left ──
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            alignment: start;
            vertical-stretch: 0;
            height: 32px;

            Text {
                text: "Target";
                color: Lx.text-muted;
                font-size: Lx.font-sm;
                vertical-alignment: center;
                horizontal-stretch: 0;
                min-width: 44px;
                height: 100%;
            }
            target_dd := LxSelectTrigger {
                trigger-width: 230px;
                text: root.target_index >= 0 && root.target_index < root.target_names.length
                    ? root.target_names[root.target_index] : "(broadcast)";
                placeholder: "(broadcast)";
                clicked => { target_popup.show(); }
            }
        }

        // ── Connection status ──
        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 6px;
            alignment: start;
            vertical-stretch: 0;

            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.connected ? Lx.green : Lx.crimson;
                vertical-stretch: 0;
            }
            Text {
                text: root.status_text;
                color: root.connected ? Lx.green : Lx.crimson;
                font-size: Lx.font-sm;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }
    }

    // Target list popup — under trigger, left-pinned (Vizia Placement::BottomStart).
    target_popup := PopupWindow {
        width: max(230px, target_dd.width);
        x: target_dd.absolute-position.x;
        y: target_dd.absolute-position.y + target_dd.height + 2px;
        height: min(56px, 4px + root.target_names.length * 20px);

        Rectangle {
            // Light list surface (Aether / Vizia FORM popup).
            background: #ffffff;
            border-radius: Lx.radius-sm;
            border-width: 1px;
            border-color: #8c8c8c;
            clip: true;

            Flickable {
                width: 100%;
                height: 100%;
                viewport-height: root.target_names.length * 20px;

                VerticalLayout {
                    alignment: start;
                    spacing: 0px;

                    for name[i] in root.target_names: Rectangle {
                        height: 20px;
                        vertical-stretch: 0;
                        background: row_ta.has-hover ? #f0f0f0 : #ffffff;

                        HorizontalLayout {
                            padding-left: 4px;
                            Text {
                                text: name;
                                font-size: Lx.font-sm;
                                color: #282828;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }

                        row_ta := TouchArea {
                            clicked => {
                                root.target_selected(i);
                                target_popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}
