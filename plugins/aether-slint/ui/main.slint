import {
    Lx, LxShellHeader, LxShellBody, LxShellMain, LxKnob, LxBandColumn, LxCycleBtn, LxButton, LxToggleBtn, LxDangerBtn,
    LxLineEdit, LxEqCurve,
} from "../../../shared-ui-slint/ui/lx.slint";
import { LxVaultSetupPopup } from "../../../shared-ui-slint/ui/lx-dialogs.slint";

// Aether window matches original Vizia UI: 720 × 395.
export component AetherUi inherits Window {
    // ── EQ band types (0=OFF, 1=LSC, 2=PK, 3=HSC) ──
    in-out property <int> eq1_type: 1;
    in-out property <int> eq2_type: 2;
    in-out property <int> eq3_type: 2;
    in-out property <int> eq4_type: 2;
    in-out property <int> eq5_type: 3;

    // Host-formatted plain values for the text fields
    in-out property <string> eq1_freq_text: "";
    in-out property <string> eq1_gain_text: "";
    in-out property <string> eq1_q_text: "";
    in-out property <string> eq2_freq_text: "";
    in-out property <string> eq2_gain_text: "";
    in-out property <string> eq2_q_text: "";
    in-out property <string> eq3_freq_text: "";
    in-out property <string> eq3_gain_text: "";
    in-out property <string> eq3_q_text: "";
    in-out property <string> eq4_freq_text: "";
    in-out property <string> eq4_gain_text: "";
    in-out property <string> eq4_q_text: "";
    in-out property <string> eq5_freq_text: "";
    in-out property <string> eq5_gain_text: "";
    in-out property <string> eq5_q_text: "";

    // Knobs (normalised 0–1)
    in-out property <float> blend: 1.0;
    in-out property <float> cf_angle: 0.666;
    in-out property <float> cf_amount: 0.0;
    in-out property <float> gain: 0.5;
    in-out property <string> blend_text: "";
    in-out property <string> cf_angle_text: "";
    in-out property <string> cf_amount_text: "";
    in-out property <string> gain_text: "";

    in-out property <int> cf_realism: 0; // 0=STANDARD, 1=LIFELIKE, 2=HYPERREAL
    in-out property <bool> bypass: false;

    in-out property <string> curve_cmds: "";
    in-out property <string> input_db_text: "--";
    in-out property <string> input_peak_text: "";

    // Header / vault
    in-out property <string> preset_name: "";
    in-out property <string> vault_path: "";
    in property <[string]> preset_names: ["Harman Flat"];
    in property <string> version: "1.2.7";

    // ── callbacks: type cycle ──
    callback eq1_type_changed(int);
    callback eq2_type_changed(int);
    callback eq3_type_changed(int);
    callback eq4_type_changed(int);
    callback eq5_type_changed(int);

    // ── callbacks: text field commits (plain-value strings) ──
    callback eq1_freq_committed(string);
    callback eq1_gain_committed(string);
    callback eq1_q_committed(string);
    callback eq2_freq_committed(string);
    callback eq2_gain_committed(string);
    callback eq2_q_committed(string);
    callback eq3_freq_committed(string);
    callback eq3_gain_committed(string);
    callback eq3_q_committed(string);
    callback eq4_freq_committed(string);
    callback eq4_gain_committed(string);
    callback eq4_q_committed(string);
    callback eq5_freq_committed(string);
    callback eq5_gain_committed(string);
    callback eq5_q_committed(string);

    // ── callbacks: knobs / mode ──
    callback blend_changed(float);
    callback cf_angle_changed(float);
    callback cf_amount_changed(float);
    callback gain_changed(float);
    callback cf_realism_changed(int);
    callback bypass_changed(bool);
    callback reset_clicked();
    callback save_clicked();
    callback vault_path_changed(string);
    callback preset_selected(string);

    title: "Aether";
    preferred-width: 720px;
    preferred-height: 395px;
    min-width: 720px;
    min-height: 395px;
    background: #171717;

    property <[string]> band-types: ["OFF", "LSC", "PK", "HSC"];
    property <[string]> realism-labels: ["STANDARD", "LIFELIKE", "HYPERREAL"];

    VerticalLayout {
        spacing: 0px;

        // ═══════════════════════════════════════════════════════════════════
        // HEADER — brand | AETHER vX | preset | SAVE SETUP BYPASS
        // ═══════════════════════════════════════════════════════════════════
        LxShellHeader {
            plugin-name: "AETHER";
            version: root.version;

            HorizontalLayout {
                spacing: 4px;
                alignment: center;

                // Preset dropdown trigger — light style, matches original Aether
                preset_dd := Rectangle {
                    width: 130px;
                    height: Lx.button-h-lg;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;
                    background: #e6e6e6;
                    border-radius: Lx.radius-sm;
                    border-width: 1px;
                    border-color: #8c8c8c;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        spacing: 4px;
                        alignment: center;

                        Text {
                            text: root.preset_name == "" ? "Select preset" : root.preset_name;
                            font-size: Lx.font-md;
                            color: #282828;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: "▼";
                            font-size: 8px;
                            color: #646464;
                            vertical-alignment: center;
                            horizontal-stretch: 0;
                        }
                    }

                    TouchArea {
                        clicked => { preset_popup.show(); }
                    }
                }

                LxLineEdit {
                    text <=> root.preset_name;
                    placeholder-text: "Preset name";
                    light: true;
                    field-width: 130px;
                    height: Lx.button-h-lg;
                    vertical-stretch: 0;
                    horizontal-stretch: 0;
                }

                Rectangle { width: 6px; background: transparent; }

                LxButton {
                    text: "SAVE";
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    height: Lx.button-h-lg;
                    min-width: 56px;
                    clicked => { root.save_clicked(); }
                }

                LxButton {
                    text: "SETUP";
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    height: Lx.button-h-lg;
                    min-width: 56px;
                    clicked => { setup_popup.show(); }
                }

                LxToggleBtn {
                    label: "BYPASS";
                    active <=> root.bypass;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    height: Lx.button-h-lg;
                    toggled(v) => { root.bypass_changed(v); }
                }
            }
        }

        // ═══════════════════════════════════════════════════════════════════
        // MAIN — curve + controls
        // ═══════════════════════════════════════════════════════════════════
        LxShellBody {
            LxShellMain {
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    vertical-stretch: 1;

                    LxEqCurve {
                height: 90px;
                vertical-stretch: 0;
                commands: root.curve_cmds;
                path-w: 696;
                path-h: 90;
                surface: #141414;
                db-top: "+6";
                db-mid: "0";
                db-bot: "-6";
                freq-lo: "20Hz";
                freq-mid: "2kHz";
                freq-hi: "20kHz";
            }

            Text {
                text: "5-Band Harman — Enter values from AutoEQ.app";
                font-size: Lx.font-md;
                color: Lx.amber;
                vertical-stretch: 0;
            }

            // ── Control row: EQ | BLEND | CROSSFEED | IO ──
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;
                alignment: stretch;

                // ── EQ (5 band columns) ──
                VerticalLayout {
                    spacing: 4px;
                    padding: 4px;
                    alignment: center;
                    horizontal-stretch: 0;
                    width: 358px;

                    Text {
                        text: "EQ";
                        font-size: Lx.font-sm;
                        color: Lx.text-secondary;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        alignment: center;

                        LxBandColumn {
                            type_choices: root.band-types;
                            type_index <=> root.eq1_type;
                            freq_text: root.eq1_freq_text;
                            gain_text: root.eq1_gain_text;
                            q_text: root.eq1_q_text;
                            type_changed(v) => { root.eq1_type_changed(v); }
                            freq_committed(s) => { root.eq1_freq_committed(s); }
                            gain_committed(s) => { root.eq1_gain_committed(s); }
                            q_committed(s) => { root.eq1_q_committed(s); }
                        }
                        LxBandColumn {
                            type_choices: root.band-types;
                            type_index <=> root.eq2_type;
                            freq_text: root.eq2_freq_text;
                            gain_text: root.eq2_gain_text;
                            q_text: root.eq2_q_text;
                            type_changed(v) => { root.eq2_type_changed(v); }
                            freq_committed(s) => { root.eq2_freq_committed(s); }
                            gain_committed(s) => { root.eq2_gain_committed(s); }
                            q_committed(s) => { root.eq2_q_committed(s); }
                        }
                        LxBandColumn {
                            type_choices: root.band-types;
                            type_index <=> root.eq3_type;
                            freq_text: root.eq3_freq_text;
                            gain_text: root.eq3_gain_text;
                            q_text: root.eq3_q_text;
                            type_changed(v) => { root.eq3_type_changed(v); }
                            freq_committed(s) => { root.eq3_freq_committed(s); }
                            gain_committed(s) => { root.eq3_gain_committed(s); }
                            q_committed(s) => { root.eq3_q_committed(s); }
                        }
                        LxBandColumn {
                            type_choices: root.band-types;
                            type_index <=> root.eq4_type;
                            freq_text: root.eq4_freq_text;
                            gain_text: root.eq4_gain_text;
                            q_text: root.eq4_q_text;
                            type_changed(v) => { root.eq4_type_changed(v); }
                            freq_committed(s) => { root.eq4_freq_committed(s); }
                            gain_committed(s) => { root.eq4_gain_committed(s); }
                            q_committed(s) => { root.eq4_q_committed(s); }
                        }
                        LxBandColumn {
                            type_choices: root.band-types;
                            type_index <=> root.eq5_type;
                            freq_text: root.eq5_freq_text;
                            gain_text: root.eq5_gain_text;
                            q_text: root.eq5_q_text;
                            type_changed(v) => { root.eq5_type_changed(v); }
                            freq_committed(s) => { root.eq5_freq_committed(s); }
                            gain_committed(s) => { root.eq5_gain_committed(s); }
                            q_committed(s) => { root.eq5_q_committed(s); }
                        }
                    }
                }

                // separator
                Rectangle { width: 1px; background: #1f2929; horizontal-stretch: 0; }

                // ── HARMAN BLEND + RESET ──
                // Same padding/title size as EQ so headers share one baseline.
                VerticalLayout {
                    spacing: 6px;
                    padding: 4px;
                    alignment: center;
                    horizontal-stretch: 0;
                    width: 104px;

                    Text {
                        width: 100%;
                        text: "HARMAN BLEND";
                        font-size: Lx.font-sm;
                        color: Lx.text-secondary;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                    }

                    // width 100% → LxKnob's internal center aligns graphic in column
                    LxKnob {
                        width: 100%;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        label: "";
                        value <=> root.blend;
                        value-text: root.blend_text;
                        changed(v) => { root.blend_changed(v); }
                    }

                    Rectangle { vertical-stretch: 1; min-height: 8px; background: transparent; }

                    // Center RESET in column
                    HorizontalLayout {
                        width: 100%;
                        vertical-stretch: 0;
                        Rectangle { horizontal-stretch: 1; }
                        LxDangerBtn {
                            label: "RESET";
                            min-width: 60px;
                            horizontal-stretch: 0;
                            clicked => { root.reset_clicked(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // separator
                Rectangle { width: 1px; background: #1f2929; horizontal-stretch: 0; }

                // ── CROSSFEED ──
                VerticalLayout {
                    spacing: 6px;
                    padding: 4px;
                    alignment: center;
                    horizontal-stretch: 0;
                    width: 131px;

                    Text {
                        width: 100%;
                        text: "CROSSFEED";
                        font-size: Lx.font-sm;
                        color: Lx.text-secondary;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                    }

                    HorizontalLayout {
                        width: 100%;
                        spacing: 6px;
                        alignment: center;
                        vertical-stretch: 0;

                        Rectangle { horizontal-stretch: 1; }
                        LxKnob {
                            horizontal-stretch: 0;
                            label: "ANGLE";
                            value <=> root.cf_angle;
                            value-text: root.cf_angle_text;
                            changed(v) => { root.cf_angle_changed(v); }
                        }
                        LxKnob {
                            horizontal-stretch: 0;
                            label: "AMOUNT";
                            value <=> root.cf_amount;
                            value-text: root.cf_amount_text;
                            changed(v) => { root.cf_amount_changed(v); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    Rectangle { vertical-stretch: 1; min-height: 8px; background: transparent; }

                    // Center STANDARD/LIFELIKE/HYPERREAL under knobs
                    HorizontalLayout {
                        width: 100%;
                        vertical-stretch: 0;
                        Rectangle { horizontal-stretch: 1; }
                        LxCycleBtn {
                            choices: root.realism-labels;
                            index <=> root.cf_realism;
                            inactive-index: 0;
                            btn-width: 110px;
                            horizontal-stretch: 0;
                            changed(v) => { root.cf_realism_changed(v); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // separator
                Rectangle { width: 1px; background: #1f2929; horizontal-stretch: 0; }

                // ── INPUT + GAIN ──
                VerticalLayout {
                    spacing: 6px;
                    padding: 4px;
                    alignment: center;
                    horizontal-stretch: 1;

                    Text {
                        width: 100%;
                        text: "INPUT";
                        font-size: Lx.font-sm;
                        color: Lx.text-secondary;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                    }
                    Text {
                        width: 100%;
                        text: root.input_db_text;
                        font-size: Lx.font-lg;
                        color: Lx.text;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                    }
                    if root.input_peak_text != "": Text {
                        width: 100%;
                        text: root.input_peak_text;
                        font-size: Lx.font-sm;
                        color: Lx.amber;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                    }

                    Rectangle { vertical-stretch: 1; min-height: 8px; background: transparent; }

                    Text {
                        width: 100%;
                        text: "GAIN";
                        font-size: Lx.font-lg;
                        color: Lx.text-secondary;
                        horizontal-alignment: center;
                        vertical-stretch: 0;
                    }

                    LxKnob {
                        width: 100%;
                        horizontal-stretch: 0;
                        vertical-stretch: 0;
                        label: "";
                        value <=> root.gain;
                        value-text: root.gain_text;
                        changed(v) => { root.gain_changed(v); }
                    }
                }
            }
        }
    }

    }

    // ── Preset list popup — anchored under the light dropdown trigger ──
    preset_popup := PopupWindow {
        width: max(146px, preset_dd.width);
        x: preset_dd.absolute-position.x;
        y: preset_dd.absolute-position.y + preset_dd.height + 2px;
        height: min(160px, 8px + root.preset_names.length * 22px);

        Rectangle {
            background: #ffffff;
            border-radius: Lx.radius-sm;
            border-width: 1px;
            border-color: #8c8c8c;
            clip: true;

            Flickable {
                width: 100%;
                height: 100%;
                viewport-height: root.preset_names.length * 22px;

                VerticalLayout {
                    alignment: start;
                    spacing: 0px;

                    for name in root.preset_names: Rectangle {
                        height: 22px;
                        vertical-stretch: 0;
                        background: row_ta.has-hover ? #f0f0f0 : #ffffff;

                        HorizontalLayout {
                            padding-left: 6px;
                            Text {
                                text: name;
                                font-size: Lx.font-md;
                                color: #282828;
                                vertical-alignment: center;
                            }
                        }

                        row_ta := TouchArea {
                            clicked => {
                                root.preset_name = name;
                                root.preset_selected(name);
                                preset_popup.close();
                            }
                        }
                    }
                }
                }
            }
        }
    }

    // Full-window dimmer keeps dialog above Path layers (spectrum/EQ).
    setup_popup := LxVaultSetupPopup {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        path <=> root.vault_path;
        plugin-label: "Aether";
        saved(p) => { root.vault_path_changed(p); }
    }
}
