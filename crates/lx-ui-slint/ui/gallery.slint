// Compile anchor for lx-ui-slint crate.
//
// Imports from the barrel (lx.slint) without re-exporting sub-components,
// so the Slint compiler does not emit "no code will be generated" warnings
// for non-Window components. Only LxGallery (which inherits Window) is
// exported from this entry point.
import {
    Lx,
    LxShellHeader, LxShellBody, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
    LxScope, LxDriftShape,
    LxCvRouting, LxCvRoute,
    LxMeterBar,
} from "lx.slint";

export component LxGallery inherits Window {
    title: "LX Shared UI";
    preferred-width: Lx.window-w;
    preferred-height: Lx.window-h;
    background: Lx.window;

    VerticalLayout {
        spacing: 0;

        LxShellHeader {
            plugin-name: "GALLERY";
            version: "0.1";
        }

        LxShellBody {
            LxShellLeft {
                title: "LEFT BAR";
                Text {
                    text: "presets / vault";
                    font-size: Lx.font-sm;
                    color: Lx.text-muted;
                }
            }

            LxShellMain {
                Text {
                    text: "MAIN PANEL";
                    font-size: Lx.font-lg;
                    color: Lx.amber-hot;
                }
                LxMeterBar {
                    height: 12px;
                    level: 0.65;
                    bar-color: Lx.amber;
                }
                LxScope {
                    height: 96px;
                    left-cmds: "M 0 50 L 10 10 L 20 90 L 30 20 L 40 80 L 50 30 L 60 70 L 70 40 L 80 60 L 90 45 L 100 55";
                    right-cmds: "M 0 50 L 10 70 L 20 30 L 30 80 L 40 20 L 50 70 L 60 30 L 70 60 L 80 40 L 90 55 L 100 45";
                }
                LxDriftShape {
                    height: 96px;
                    commands: "M 0 50 L 25 50 L 50 10 L 75 90 L 100 50";
                    x-label: "X 0.50";
                    y-label: "Y 0.50";
                }
                LxCvRouting {
                    LxCvRoute { label: "CUT SRC"; src: 4; has-scale: true; scale-label: "CUT SCL"; scale: 1.0; }
                    LxCvRoute { label: "Y SRC"; src: 5; has-scale: true; scale-label: "Y SCL"; }
                    LxCvRoute { label: "X SRC"; }
                    LxCvRoute { label: "RESO SRC"; }
                }
            }

            LxShellRight {
                title: "RIGHT BAR";
                Text {
                    text: "meters / gonio";
                    font-size: Lx.font-sm;
                    color: Lx.text-muted;
                }
            }
        }

        LxShellFooter {
            Text {
                text: "FOOTER";
                font-size: Lx.font-sm;
                color: Lx.amber-hot;
                vertical-alignment: center;
            }
        }
    }
}
