// Branded LX controls — custom knob/slider/segmented; no @aura import
// (LX UI ships its own components; @aura is available via aura-build but unused here).

import { Lx } from "lx-theme.slint";

// ─── Compact amber knob ──────────────────────────────────────────────────────

export component LxKnob inherits VerticalLayout {
    in property <string> label: "";
    in-out property <float> value: 0.5;
    in property <string> value-text: "";
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <float> step: 0.0;          // 0 = continuous; 1, 2, ... = discrete
    in property <bool> small: false;        // uses Lx.knob-d-sm instead of Lx.knob-d
    in property <float> default-value: 0.5; // right-click resets to this value
    // Greyed + no drag (e.g. Aurum Ceil S / Soft S when clip M/S off).
    in property <bool> enabled: true;

    callback changed(float);

    spacing: Lx.knob-gap;
    alignment: center;
    opacity: root.enabled ? 1.0 : 0.35;

    property <length> diameter: root.small ? Lx.knob-d-sm : Lx.knob-d;
    property <float> norm: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);

    // Arc from 7:30 (135°) to 4:30 (135° + 270° * value), clockwise.
    function knob_arc_commands(cx: float, cy: float, r: float, value: float) -> string {
        return "M " + (cx + r * cos(135deg)) + " " + (cy + r * sin(135deg))
            + " A " + r + " " + r + " 0 " + ((clamp(value, 0, 1) * 270) > 180 ? 1 : 0) + " 1 "
            + (cx + r * cos((135 + clamp(value, 0, 1) * 270) * 1deg)) + " "
            + (cy + r * sin((135 + clamp(value, 0, 1) * 270) * 1deg));
    }

    function value_from_drag(
        start_norm: float,
        delta_y: length,
        minimum: float,
        maximum: float,
        step: float,
    ) -> float {
        return step > 0
            ? clamp(
                round((minimum + clamp(start_norm + delta_y / 1px * 0.003, 0, 1) * (maximum - minimum)) / step) * step,
                minimum, maximum
              )
            : clamp(
                minimum + clamp(start_norm + delta_y / 1px * 0.003, 0, 1) * (maximum - minimum),
                minimum, maximum
              );
    }

    // Label above the knob graphic. width 100% so center works when parent
    // assigns a wider column (e.g. HARMAN BLEND / GAIN).
    if root.label != "": Text {
        width: 100%;
        text: root.label;
        font-size: Lx.font-xs;
        color: Lx.text-label;
        horizontal-alignment: center;
        vertical-stretch: 0;
    }

    // Soft-3D knob (FemtoVG): radial dome, metal bezel, drop-shadow.
    // Diameter tokens unchanged — shadows are paint-only (no layout grow).
    Rectangle {
        width: root.diameter;
        height: root.diameter;
        background: transparent;
        vertical-stretch: 0;
        horizontal-stretch: 0;

        // Cast shadow under the whole disc
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: root.diameter / 2;
            background: #00000001;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Lx.shadow-knob-y;
            drop-shadow-blur: Lx.shadow-knob-blur;
            drop-shadow-color: Lx.shadow-soft;
        }

        // Outer metal bezel — lit from above
        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: root.diameter / 2;
            background: @linear-gradient(160deg, Lx.metal-hi 0%, Lx.metal-mid 42%, Lx.metal-lo 100%);
            border-width: 1px;
            border-color: Lx.edge-dark;
        }

        // Inner bezel rim (brighter top)
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: parent.width - 3px;
            height: parent.height - 3px;
            border-radius: (root.diameter - 3px) / 2;
            background: @linear-gradient(180deg, #ffffff22 0%, #00000000 38%, #00000055 100%);
        }

        // Recess well between bezel and face
        Rectangle {
            x: root.diameter * 0.10;
            y: root.diameter * 0.10;
            width: root.diameter * 0.80;
            height: root.diameter * 0.80;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, Lx.well-lo 0%, Lx.well-hi 70%, #000000 100%);
            border-width: 1px;
            border-color: #00000066;
        }

        // Convex face — radial dome (highlight toward center)
        Rectangle {
            x: root.diameter * 0.13;
            y: root.diameter * 0.13;
            width: root.diameter * 0.74;
            height: root.diameter * 0.74;
            border-radius: self.width / 2;
            background: @radial-gradient(circle, Lx.face-hi 0%, Lx.face-mid 48%, Lx.face-lo 100%);
            border-width: 1px;
            border-color: #ffffff14;
        }

        // Specular cap (upper third) — sells the dome
        Rectangle {
            x: root.diameter * 0.22;
            y: root.diameter * 0.16;
            width: root.diameter * 0.56;
            height: root.diameter * 0.28;
            border-radius: self.height / 2;
            background: @linear-gradient(180deg, #ffffff38 0%, #ffffff10 55%, #ffffff00 100%);
        }

        // Soft bottom occlusion on face
        Rectangle {
            x: root.diameter * 0.18;
            y: root.diameter * 0.52;
            width: root.diameter * 0.64;
            height: root.diameter * 0.32;
            border-radius: self.width / 2;
            background: @linear-gradient(0deg, #00000055 0%, #00000000 100%);
        }

        // Track arc (full 270° range)
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-x: 0; viewbox-y: 0;
            viewbox-width: 100; viewbox-height: 100;
            commands: root.knob_arc_commands(50, 50, 44, 1.0);
            stroke: #1a1a1ecc;
            stroke-width: Lx.knob-stroke;
            fill: transparent;
        }

        // Value arc
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-x: 0; viewbox-y: 0;
            viewbox-width: 100; viewbox-height: 100;
            commands: root.knob_arc_commands(50, 50, 44, root.norm);
            stroke: ta.pressed ? Lx.amber-hot : (ta.has-hover ? Lx.amber-soft : Lx.amber);
            stroke-width: Lx.knob-stroke;
            fill: transparent;
        }

        // Pointer cap — small raised bead
        Rectangle {
            property <angle> angle_rad: (135 + root.norm * 270) * 1deg;
            property <length> orbit_r: root.diameter * 0.26;
            property <length> pd: Lx.knob-pointer;

            x: root.diameter / 2 + orbit_r * cos(angle_rad) - pd / 2;
            y: root.diameter / 2 + orbit_r * sin(angle_rad) - pd / 2;
            width: pd;
            height: pd;
            border-radius: pd / 2;
            background: @radial-gradient(circle, #f0f0f8 0%, #b8b8c4 55%, #5a5a66 100%);
            border-width: 1px;
            border-color: #00000055;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: 1px;
            drop-shadow-blur: 2px;
            drop-shadow-color: Lx.shadow-hard;
        }

        ta := TouchArea {
            enabled: root.enabled;
            property <length> drag_start_y;
            property <float> drag_start_norm;

            pointer-event(event) => {
                if !root.enabled { return; }
                if event.kind == PointerEventKind.down {
                    if event.button == PointerEventButton.right {
                        root.value = root.default-value;
                        root.changed(root.default-value);
                    } else {
                        self.drag_start_y = self.mouse-y;
                        self.drag_start_norm = root.norm;
                    }
                }
            }
            moved => {
                if root.enabled && self.pressed {
                    root.value = root.value_from_drag(
                        self.drag_start_norm,
                        self.drag_start_y - self.mouse_y,
                        root.minimum, root.maximum, root.step
                    );
                    root.changed(root.value);
                }
            }
        }
    }

    // Formatted value text below the knob.
    if root.value-text != "": Text {
        width: 100%;
        text: root.value-text;
        font-size: Lx.font-xs;
        color: Lx.text-secondary;
        horizontal-alignment: center;
        vertical-stretch: 0;
    }
}

// ─── Custom line edit with amber focus ───────────────────────────────────────

export component LxLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    // Light style matches original Aether preset/EQ value fields (white box).
    in property <bool> light: false;
    in property <length> field-width: 0px; // 0 = stretch
    out property <bool> has-focus: ti.has-focus;

    // Tab / FocusScope.focus() must reach TextInput, not this shell.
    forward-focus: ti;

    callback accepted(string); // Enter pressed
    // Focus-lost commit. Host callbacks MUST ignore this during editor teardown
    // (TextInput loses focus while the component tree is destroyed).
    callback committed(string);
    // Live keystroke edits (Vizia on_edit parity) — Lucent/Relay name ↔ SHM.
    callback edited(string);

    height: Lx.button-h;
    // field-width > 0 → fixed width; otherwise stretch in parent.
    min-width: root.field-width > 0px ? root.field-width : 40px;
    max-width: root.field-width > 0px ? root.field-width : 9999px;
    horizontal-stretch: root.field-width > 0px ? 0 : 1;
    // Inset field: dark→light vertical sells a recessed trough (FemtoVG).
    background: root.light
        ? @linear-gradient(180deg, #e8e8e8 0%, #f8f8f8 100%)
        : @linear-gradient(180deg, Lx.well-hi 0%, Lx.well-lo 100%);
    border-radius: Lx.radius-sm;
    border-width: 1px;
    border-color: ti.has-focus ? Lx.amber : (root.light ? #8c8c8c : Lx.edge-dark);
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: ti.has-focus ? 0px : 1px;
    drop-shadow-blur: ti.has-focus ? 4px : 2px;
    drop-shadow-color: ti.has-focus ? Lx.glow-amber : #00000044;

    property <bool> was-focused: false;
    // Set false from host before destroying the UI if possible; also
    // host-side live flags must gate automate (see aether editor).
    in-out property <bool> allow-commit: true;

    // pony: programmatic focus for overlays/dialogs that don't auto-focus.
    public function focus-input() {
        ti.focus();
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;

        Rectangle {
            clip: true;
            vertical-stretch: 1;

            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder-text;
                color: root.light ? #808080 : Lx.text-muted;
                font-size: Lx.font-md;
                vertical-alignment: center;
            }

            ti := TextInput {
                width: 100%;
                height: 100%;
                text <=> root.text;
                color: root.light ? #282828 : Lx.text;
                font-size: Lx.font-md;
                vertical-alignment: center;
                single-line: true;
                accepted => {
                    if root.allow-commit {
                        root.accepted(root.text);
                    }
                }
                edited => {
                    if root.allow-commit {
                        root.edited(root.text);
                    }
                }
                changed has-focus => {
                    if root.was-focused && !self.has-focus && root.allow-commit {
                        root.committed(root.text);
                    }
                    root.was-focused = self.has-focus;
                }
            }

            // pony: safety-net — click-to-focus when TextInput doesn't
            // naturally get it (overlays, FocusScope transitions).
            if !ti.has-focus: TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.focus-input(); }
            }
        }
    }
}

// ─── Host-synced param field (skips overwrite while focused) ──────────────────

export component LxParamField inherits VerticalLayout {
    in property <string> label: "";
    // Host-formatted display value. Applied only when the field is not focused.
    in property <string> value-text: "";
    in property <bool> light: true;
    in property <length> field-width: 56px;

    callback committed(string);

    spacing: 2px;
    alignment: center;
    horizontal-stretch: 0;

    property <string> local-text: "";
    property <bool> seeded: false;

    changed value-text => {
        // Only push host text when idle and the value actually changed —
        // avoids thrashing TextInput every frame from the host sync.
        if !edit.has-focus && root.local-text != root.value-text {
            root.local-text = root.value-text;
        }
    }

    init => {
        root.local-text = root.value-text;
        root.seeded = true;
    }

    if root.label != "": Text {
        text: root.label;
        font-size: Lx.font-xs;
        color: Lx.text-label;
        horizontal-alignment: center;
        vertical-stretch: 0;
    }

    edit := LxLineEdit {
        text <=> root.local-text;
        light: root.light;
        field-width: root.field-width;
        horizontal-stretch: 0;
        accepted(s) => { root.committed(s); }
        committed(s) => { root.committed(s); }
    }
}

// ─── Cycle button (click to advance LSC/PK/HSC/OFF, STANDARD/LIFE/HYPER, …) ─

export component LxCycleBtn inherits Rectangle {
    in property <[string]> choices: ["OFF", "LSC", "PK", "HSC"];
    in-out property <int> index: 0;
    // When true, amber fill if index != inactive-index (default 0 = OFF).
    in property <int> inactive-index: 0;
    in property <length> btn-width: 56px;
    in property <length> btn-height: Lx.button-h;

    callback changed(int);

    property <bool> active: root.index != root.inactive-index;
    // Clamp index so a host race / out-of-range discrete never panics Slint.
    property <int> safe-index: root.choices.length == 0
        ? 0
        : min(max(root.index, 0), root.choices.length - 1);
    property <string> label: root.choices.length == 0 ? "" : root.choices[root.safe-index];

    width: root.btn-width;
    height: root.btn-height;
    border-radius: Lx.radius-sm;
    border-width: 1px;
    border-color: root.active ? #ffffff33 : Lx.edge-dark;
    background: root.active
        ? @linear-gradient(180deg, Lx.amber-hi 0%, Lx.amber 45%, Lx.amber-lo 100%)
        : @linear-gradient(180deg, Lx.raise-hi 0%, Lx.control 50%, Lx.raise-lo 100%);
    drop-shadow-offset-x: 0px;
    drop-shadow-offset-y: Lx.shadow-btn-y;
    drop-shadow-blur: Lx.shadow-btn-blur;
    drop-shadow-color: Lx.shadow-soft;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    Text {
        width: 100%;
        height: 100%;
        text: root.label;
        font-size: Lx.font-xs;
        font-weight: 600;
        color: root.active ? Lx.text : Lx.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        clicked => {
            if root.choices.length > 0 {
                root.index = Math.mod(root.safe-index + 1, root.choices.length);
                root.changed(root.index);
            }
        }
    }

    states [
        hover when ta.has-hover && root.active: {
            background: @linear-gradient(180deg, Lx.amber-soft 0%, Lx.amber 50%, Lx.amber-lo 100%);
        }
        pressed when ta.pressed && root.active: {
            background: @linear-gradient(180deg, Lx.amber-lo 0%, Lx.amber 60%, Lx.amber-hi 100%);
            drop-shadow-offset-y: 0px;
            drop-shadow-blur: 1px;
        }
        hover when ta.has-hover && !root.active: {
            background: @linear-gradient(180deg, Lx.control-hover 0%, Lx.control 55%, Lx.raise-lo 100%);
        }
        pressed when ta.pressed && !root.active: {
            background: @linear-gradient(180deg, Lx.raise-lo 0%, Lx.control-active 100%);
            drop-shadow-offset-y: 0px;
            drop-shadow-blur: 1px;
        }
    ]
}

// ─── 3-state segmented button (A/B/C style) ──────────────────────────────────

// Segmented exclusive buttons. Horizontal by default; `vertical: true` stacks.
// Soft-3D: recessed tray + raised active pill.
export component LxSegmentedButton inherits Rectangle {
    in-out property <float> index: 0.0;
    in property <[string]> choices: ["A", "B", "C"];
    // Compact = Meridian EQ A/B/C pills (tiny); default fits "12 dB"/"24 dB".
    in property <bool> compact: false;
    in property <bool> vertical: false;

    callback changed(float);

    background: @linear-gradient(180deg, Lx.well-hi 0%, Lx.well-lo 100%);
    border-radius: Lx.radius-md;
    border-width: 1px;
    border-color: Lx.edge-dark;
    // Inset look for the tray (shadow under raised pills only).
    // Compact = fixed pill strip. Default horizontal used to min-width:0 +
    // stretch:1 and collapsed under header siblings (Lucent Own/Both/Relay).
    horizontal-stretch: root.compact ? 0 : 1;
    vertical-stretch: 0;
    // Compact ABC fixed width; vertical 12/24 needs a bit more;
    // horizontal non-compact: room for ~3 short labels (caller may override).
    min-width: root.compact ? 66px : (root.vertical ? 44px : 96px);
    max-width: root.compact ? 66px : 9999px;

    property <length> seg-h: root.compact ? 16px : Lx.button-h-sm;
    property <length> gap: root.compact ? 1px : 2px;
    property <length> tray-pad: root.compact ? 1px : 2px;
    // Vertical stack height for 2–3 segments (Filter 12/24, etc.).
    height: root.vertical
        ? (root.choices.length >= 3 ? root.seg-h * 3 + root.gap * 2 + root.tray-pad * 2
            : root.seg-h * 2 + root.gap + root.tray-pad * 2)
        : root.seg-h + root.tray-pad * 2;

    if !root.vertical: HorizontalLayout {
        spacing: root.gap;
        padding: root.tray-pad;
        width: 100%;
        height: 100%;
        alignment: center;

        for choice[i] in root.choices: Rectangle {
            // Round float index — host/sync may not be exact int equality.
            property <bool> active: Math.round(root.index) == i;
            horizontal-stretch: 1;
            min-width: root.compact ? 20px : 28px;
            height: 100%;
            border-radius: Lx.radius-sm;
            border-width: active ? 1px : 0px;
            border-color: #ffffff28;
            background: active
                ? @linear-gradient(180deg, Lx.amber-hi 0%, Lx.amber 50%, Lx.amber-lo 100%)
                : transparent;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: active ? 1px : 0px;
            drop-shadow-blur: active ? 2px : 0px;
            drop-shadow-color: Lx.shadow-soft;

            Text {
                width: 100%;
                height: 100%;
                text: choice;
                font-size: root.compact ? 8px : Lx.font-xs;
                font-weight: 600;
                color: active ? Lx.text : Lx.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ta_h := TouchArea {
                clicked => {
                    root.index = i;
                    root.changed(i);
                }
            }

            states [
                hover when ta_h.has-hover && !active: {
                    background: #ffffff10;
                }
                pressed when ta_h.pressed && !active: {
                    background: #00000030;
                }
            ]
        }
    }

    if root.vertical: VerticalLayout {
        spacing: root.gap;
        padding: root.tray-pad;
        width: 100%;
        height: 100%;
        alignment: center;

        for choice[i] in root.choices: Rectangle {
            property <bool> active: Math.round(root.index) == i;
            horizontal-stretch: 1;
            height: root.seg-h;
            vertical-stretch: 0;
            border-radius: Lx.radius-sm;
            border-width: active ? 1px : 0px;
            border-color: #ffffff28;
            background: active
                ? @linear-gradient(180deg, Lx.amber-hi 0%, Lx.amber 50%, Lx.amber-lo 100%)
                : transparent;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: active ? 1px : 0px;
            drop-shadow-blur: active ? 2px : 0px;
            drop-shadow-color: Lx.shadow-soft;

            Text {
                width: 100%;
                height: 100%;
                text: choice;
                font-size: root.compact ? 8px : Lx.font-xs;
                font-weight: 600;
                color: active ? Lx.text : Lx.text-secondary;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            ta_v := TouchArea {
                clicked => {
                    root.index = i;
                    root.changed(i);
                }
            }

            states [
                hover when ta_v.has-hover && !active: {
                    background: #ffffff10;
                }
                pressed when ta_v.pressed && !active: {
                    background: #00000030;
                }
            ]
        }
    }
}

// ─── Custom LX controls ──────────────────────────────────────────────────────

// ─── Custom horizontal slider ────────────────────────────────────────────────

export component LxSlider inherits VerticalLayout {
    in property <string> label: "";
    in-out property <float> value: 0.5;
    in property <float> minimum: 0.0;
    in property <float> maximum: 1.0;
    in property <string> value-text: "";
    in property <float> default-value: 0.5; // right-click resets to this value
    // Dense EQ-band columns (Meridian 5-across).
    in property <bool> compact: false;

    callback changed(float);

    spacing: root.compact ? 1px : Lx.knob-gap;
    alignment: stretch;
    // Only min-width (no width/max-width combo — Slint forbids it).
    min-width: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 0;

    property <length> track-h: root.compact ? 3px : 4px;
    property <length> thumb-d: root.compact ? 10px : 12px;
    property <float> norm: clamp((root.value - root.minimum) / (root.maximum - root.minimum), 0, 1);

    // Label above the track.
    if root.label != "": Text {
        text: root.label;
        font-size: root.compact ? 8px : Lx.font-xs;
        color: Lx.text-label;
        horizontal-alignment: center;
        vertical-stretch: 0;
        overflow: elide;
    }

    // Track + thumb (recessed well + raised metal thumb with dome + shadow).
    Rectangle {
        horizontal-stretch: 1;
        height: root.thumb-d;
        background: transparent;
        vertical-stretch: 0;

        // Inactive track well (inset channel).
        Rectangle {
            y: (parent.height - root.track-h) / 2;
            height: root.track-h;
            width: 100%;
            background: @linear-gradient(180deg, Lx.well-hi 0%, Lx.steel 55%, Lx.well-lo 100%);
            border-radius: root.track-h / 2;
            border-width: 1px;
            border-color: #00000066;
        }

        // Active (amber) fill with soft bevel.
        Rectangle {
            x: 0;
            y: (parent.height - root.track-h) / 2;
            height: root.track-h;
            width: root.norm * (parent.width - root.thumb-d) + root.thumb-d / 2;
            background: @linear-gradient(180deg, Lx.amber-hi 0%, Lx.amber 55%, Lx.amber-lo 100%);
            border-radius: root.track-h / 2;
            border-width: 1px;
            border-color: #ffffff22;
        }

        // Raised thumb — radial dome + drop-shadow (size still thumb-d).
        Rectangle {
            x: root.norm * (parent.width - root.thumb-d);
            y: (parent.height - root.thumb-d) / 2;
            width: root.thumb-d;
            height: root.thumb-d;
            border-radius: root.thumb-d / 2;
            background: @radial-gradient(circle, #f4f4fa 0%, #c8c8d2 45%, #6a6a74 100%);
            border-width: 1px;
            border-color: #00000055;
            drop-shadow-offset-x: 0px;
            drop-shadow-offset-y: Lx.shadow-thumb-y;
            drop-shadow-blur: Lx.shadow-thumb-blur;
            drop-shadow-color: Lx.shadow-hard;

            // Specular fleck
            Rectangle {
                x: root.thumb-d * 0.18;
                y: root.thumb-d * 0.14;
                width: root.thumb-d * 0.55;
                height: root.thumb-d * 0.35;
                border-radius: self.height / 2;
                background: @linear-gradient(180deg, #ffffffaa 0%, #ffffff00 100%);
            }
        }

        ta := TouchArea {
            property <length> drag_start_x;
            property <float> drag_start_norm;

            function set_from_x(x: length) {
                root.value = clamp(
                    root.minimum + (x / 1px) / ((parent.width - root.thumb-d) / 1px) * (root.maximum - root.minimum),
                    root.minimum, root.maximum
                );
                root.changed(root.value);
            }

            pointer-event(event) => {
                if event.kind == PointerEventKind.down {
                    if event.button == PointerEventButton.right {
                        root.value = root.default-value;
                        root.changed(root.default-value);
                    } else {
                        self.drag_start_x = self.mouse-x;
                        self.drag_start_norm = root.norm;
                        // Click-to-set: jump immediately on press.
                        self.set_from_x(self.mouse-x - root.thumb-d / 2);
                    }
                }
            }
            moved => {
                if self.pressed {
                    let delta_px = (self.mouse-x - self.drag_start_x) / 1px;
                    let track_px = (parent.width - root.thumb-d) / 1px;
                    root.value = clamp(
                        root.minimum + (self.drag_start_norm + delta_px / track_px) * (root.maximum - root.minimum),
                        root.minimum, root.maximum
                    );
                    root.changed(root.value);
                }
            }
        }
    }

    // Formatted value below the track.
    if root.value-text != "": Text {
        text: root.value-text;
        font-size: root.compact ? 8px : Lx.font-xs;
        color: Lx.text-secondary;
        horizontal-alignment: center;
        vertical-stretch: 0;
        overflow: elide;
    }
}

// One Meridian 5-band EQ column. Five equal stretch columns in a HorizontalLayout.
// preferred-width is a modest equal base so layout does not blow past the shell.
export component LxEqBandColumn inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    in property <string> q-label: "Filter Q";

    in-out property <float> gain: 0.5;
    in property <string> gain-text: "";
    in property <float> gain-default: 0.5;
    callback gain_changed(float);

    in-out property <float> freq: 0.5;
    in property <string> freq-text: "";
    in property <float> freq-default: 0.5;
    callback freq_changed(float);

    in-out property <float> slope: 1.0;
    callback slope_changed(float);

    horizontal-stretch: 1;
    min-width: 70px;
    preferred-height: 98px;
    // Parent LxSection can grow; columns fill leftover EQ card height.
    vertical-stretch: 1;
    background: transparent;
    clip: true;

    // Absolute fill — size from parent stretch, not preferred-width blowout.
    VerticalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        spacing: 1px;
        alignment: stretch;
        padding-left: 3px;
        padding-right: 3px;

        Text {
            text: root.title;
            font-size: Lx.font-xs;
            font-weight: 700;
            color: Lx.amber-hot;
            horizontal-alignment: center;
            overflow: elide;
            vertical-stretch: 0;
        }
        Text {
            text: root.subtitle;
            font-size: 8px;
            color: Lx.text-muted;
            horizontal-alignment: center;
            overflow: elide;
            vertical-stretch: 0;
        }
        LxSlider {
            compact: true;
            value <=> root.gain;
            value-text: root.gain-text;
            default-value: root.gain-default;
            changed(v) => { root.gain_changed(v); }
        }
        LxSlider {
            compact: true;
            value <=> root.freq;
            value-text: root.freq-text;
            default-value: root.freq-default;
            changed(v) => { root.freq_changed(v); }
        }
        Text {
            text: root.q-label;
            font-size: 8px;
            color: Lx.text-muted;
            horizontal-alignment: center;
            overflow: elide;
            vertical-stretch: 0;
        }
        HorizontalLayout {
            alignment: center;
            vertical-stretch: 0;
            LxSegmentedButton {
                compact: true;
                index <=> root.slope;
                changed(v) => { root.slope_changed(v); }
            }
        }
    }
}


// EQ band column — Aether style: cycle type button + FREQ/GAIN/Q text fields.
// Tab order follows field tree order (freq → gain → q → next band).
export component LxBandColumn inherits VerticalLayout {
    in property <[string]> type_choices: ["OFF", "LSC", "PK", "HSC"];
    in-out property <int> type_index: 0;

    // Host-formatted plain values (e.g. "105", "2.8", "0.70").
    in property <string> freq_text: "";
    in property <string> gain_text: "";
    in property <string> q_text: "";

    in property <length> field-width: 56px;

    callback type_changed(int);
    // Committed plain-value text from the fields (parse + normalize in Rust).
    callback freq_committed(string);
    callback gain_committed(string);
    callback q_committed(string);

    spacing: 2px;
    alignment: center;
    horizontal-stretch: 0;

    LxCycleBtn {
        choices: root.type_choices;
        index <=> root.type_index;
        btn-width: root.field-width;
        changed(v) => { root.type_changed(v); }
    }

    LxParamField {
        label: "FREQ";
        value-text: root.freq_text;
        field-width: root.field-width;
        committed(s) => { root.freq_committed(s); }
    }

    LxParamField {
        label: "GAIN";
        value-text: root.gain_text;
        field-width: root.field-width;
        committed(s) => { root.gain_committed(s); }
    }

    LxParamField {
        label: "Q";
        value-text: root.q_text;
        field-width: root.field-width;
        committed(s) => { root.q_committed(s); }
    }
}
