// LX-branded reusable Slint components — CI barrel.
//
// Import from a plugin (path relative to plugin ui/main.slint):
//   import {
//       Lx, LxShellHeader, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
//       LxKnob, LxSpectrum, LxGoniometer, LxLedPeakMeter, ...
//   } from "../../../crates/lx-ui-slint/ui/lx.slint";

// Bundled JetBrains Mono (Regular + Bold via lx-slint-build include path).
// Registering the faces here fixes text metrics cross-platform — without a
// bundled font Slint resolves the OS default (Segoe UI / DejaVu Sans …)
// and tightly budgeted layouts (footer-h) overflow on Linux.
import "JetBrainsMono-Regular.ttf";
import "JetBrainsMono-Bold.ttf";
import "NotoSans-Regular.ttf";
import "NotoSans-Bold.ttf";
import "Selawik-Regular.ttf";
import "Selawik-Bold.ttf";

import { Lx } from "lx-theme.slint";
import {
    LxTabs, LxPanel, LxSection, LxToggleBtn, LxButton, LxDangerBtn,
    LxSelectTrigger,
} from "lx-chrome.slint";
import {
    LxBrandLogo, LxShellHeader, LxShellBody, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
} from "lx-shell.slint";
import {
    LxKnob, LxLineEdit, LxParamField, LxCycleBtn, LxSegmentedButton,
    LxSlider, LxEqBandColumn, LxBandColumn,
} from "lx-controls.slint";
import {
    LxMeterBar, LxCorrelation, LxLedColumn, LxLedPeakMeter,
} from "lx-meters.slint";
import {
    LxSpectrum, LxEqCurve, LxGoniometer, LxCompDisplay,
} from "lx-viz.slint";
export {
    Lx,
    LxTabs, LxPanel, LxSection, LxToggleBtn, LxButton, LxDangerBtn,
    LxSelectTrigger,
    LxBrandLogo, LxShellHeader, LxShellBody, LxShellLeft, LxShellMain, LxShellRight, LxShellFooter,
    LxKnob, LxLineEdit, LxParamField, LxCycleBtn, LxSegmentedButton,
    LxSlider, LxEqBandColumn, LxBandColumn,
    LxMeterBar, LxCorrelation, LxLedColumn, LxLedPeakMeter,
    LxSpectrum, LxEqCurve, LxGoniometer, LxCompDisplay,
}

// Compile anchor for lx-ui-slint crate.
export component LxGallery inherits Window {
    title: "LX Shared UI";
    preferred-width: Lx.window-w;
    preferred-height: Lx.window-h;
    background: Lx.window;

    VerticalLayout {
        spacing: 0;

        LxShellHeader {
            plugin-name: "GALLERY";
            version: "0.1";
        }

        LxShellBody {
            LxShellLeft {
                title: "LEFT BAR";
                Text {
                    text: "presets / vault";
                    font-size: Lx.font-sm;
                    color: Lx.text-muted;
                }
            }

            LxShellMain {
                Text {
                    text: "MAIN PANEL";
                    font-size: Lx.font-lg;
                    color: Lx.amber-hot;
                }
                LxMeterBar {
                    height: 12px;
                    level: 0.65;
                    bar-color: Lx.amber;
                }
            }

            LxShellRight {
                title: "RIGHT BAR";
                Text {
                    text: "meters / gonio";
                    font-size: Lx.font-sm;
                    color: Lx.text-muted;
                }
            }
        }

        LxShellFooter {
            Text {
                text: "FOOTER";
                font-size: Lx.font-sm;
                color: Lx.amber-hot;
                vertical-alignment: center;
            }
        }
    }
}
