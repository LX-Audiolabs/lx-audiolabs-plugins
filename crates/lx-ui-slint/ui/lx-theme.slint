// LX Audiolabs design tokens — brand CI + soft-3D (FemtoVG / GPU).
// Depth: linear + radial gradients, drop-shadow, layered discs.
// Layout sizes stay token-driven (knob-d, button-h, …) — shadows are paint-only.

export global Lx {
    // Surfaces — neutral gray ladder (classic LX / Aether), not pure black.
    // #141414 < #171717 < #191919 < #1c1c1c … readable steps under soft-3D.
    out property <color> void: #141414;          // deepest pit / spectrum floor
    out property <color> window: #171717;        // main chrome (Aether base)
    out property <color> panel: #191919;         // sidebars / shell zones
    out property <color> section: #1c1c1c;       // LxSection cards / trays
    out property <color> control: #262626;
    out property <color> control-hover: #404040;
    out property <color> control-active: #555555;

    // Soft-3D surface stops (buttons, well, knob face) — gray family
    out property <color> raise-hi: #454545;       // top edge of raised control
    out property <color> raise-lo: #161616;       // bottom of raised control
    out property <color> well-hi: #0e0e0e;        // top of recessed well (darker)
    out property <color> well-lo: #222222;        // bottom of recessed well
    out property <color> edge-light: #ffffff33;   // 1px highlight rim
    out property <color> edge-dark: #00000066;    // 1px shadow rim
    out property <color> metal-hi: #5a5a5a;       // bezel / ring highlight
    out property <color> metal-mid: #2e2e2e;
    out property <color> metal-lo: #121212;
    out property <color> face-hi: #3a3a3a;        // knob face highlight (dome top)
    out property <color> face-mid: #222222;
    out property <color> face-lo: #141414;
    out property <color> stage: #141414;          // analyzer / spectrum pit
    out property <color> stage-rim: #2a2a2a;

    // Drop-shadow tokens (FemtoVG). Offset/blur only — do not change layout size.
    out property <color> shadow-soft: #00000088;
    out property <color> shadow-hard: #000000aa;
    out property <color> glow-amber: #ff731a44;
    out property <length> shadow-btn-y: 1px;
    out property <length> shadow-btn-blur: 3px;
    out property <length> shadow-knob-y: 2px;
    out property <length> shadow-knob-blur: 5px;
    out property <length> shadow-thumb-y: 1px;
    out property <length> shadow-thumb-blur: 3px;

    // Brand / accent
    out property <color> amber: #ff731a;
    out property <color> amber-hot: #ff8c1a;
    out property <color> amber-soft: #ff8c3f;
    out property <color> amber-dim: #ff731a55;
    out property <color> amber-hi: #ffb06a;       // amber bevel top
    out property <color> amber-lo: #c45010;       // amber bevel bottom

    // Status / levels
    out property <color> green: #00bf4d;
    out property <color> green-soft: #00d959;
    out property <color> green-hi: #33e070;
    out property <color> green-lo: #008a38;
    out property <color> crimson: #e04545;
    out property <color> crimson-hi: #ff6a6a;
    out property <color> crimson-lo: #a02828;
    out property <color> danger-bg: #331414;
    out property <color> danger-text: #e68080;
    out property <color> gold: #be9614;
    out property <color> gonio: #19e680;
    out property <color> spectrum: #4d99f2;
    out property <color> spectrum-fill: #4d99f24d;
    out property <color> spectrum-glow: #6ab0ff66;
    out property <color> eq-curve: #ff8c1a;
    out property <color> gr: #e04545;

    // LED meter segment palette (Slint-native hardware look)
    out property <color> led-off: #1a1a1e;
    out property <color> led-green: #18c45a;
    out property <color> led-amber: #f0a020;
    out property <color> led-red: #e04040;
    out property <color> led-hold: #ffffff;

    // Structure
    out property <color> steel: #2e2e2e;        // dividers (reads on #1717–#1c1c)
    out property <color> grid: #ffffff14;
    out property <color> grid-strong: #ffffff20;
    out property <color> tick: #ffffff73;

    // Type
    out property <color> text: #f5f5f5;
    out property <color> text-secondary: #bfbfc8;
    out property <color> text-muted: #8c8c99;
    out property <color> text-dim: #ffffff40;
    out property <color> text-label: #8c8c99;

    // Radii
    out property <length> radius-sm: 3px;
    out property <length> radius-md: 5px;
    out property <length> radius-lg: 8px;

    // Spacing
    out property <length> pad-sm: 6px;
    out property <length> pad-md: 10px;
    out property <length> pad-lg: 12px;
    out property <length> gap-sm: 6px;
    out property <length> gap-md: 10px;
    out property <length> gap-lg: 12px;

    // Type scale
    out property <length> font-xs: 9px;
    out property <length> font-sm: 10px;
    out property <length> font-md: 11px;
    out property <length> font-lg: 14px;

    // ── Control sizes ──────────────────────────────────────────────────────
    // Shared chrome language for ALL plugins. Which buttons appear is per-plugin;
    // when a control exists, it uses these tokens — do not invent local heights.
    //
    //   button-h     → default for LxButton / LxToggleBtn / LxDangerBtn /
    //                  LxLineEdit / LxSelectTrigger / header actions.
    //   button-h-sm  → dense body only (solo "S", tight toolbars). NOT header.
    //   button-h-lg  → rare oversized chrome; do not use for standard actions.
    out property <length> button-h: 22px;
    out property <length> button-h-sm: 18px;
    out property <length> button-h-lg: 30px;
    out property <length> header-h: 50px;       // frozen header zone
    out property <length> header-h-sm: 40px;    // compact window (legacy)
    out property <length> footer-h: 110px;      // frozen footer zone
    out property <length> stereo-meter-h: 180px;
    out property <length> left-bar-w: 180px;    // vault / presets sidebar
    out property <length> right-bar-w: 155px;   // frozen output sidebar
    out property <length> sidebar-w: 155px;     // alias → right bar
    out property <length> gonio-h: 139px;
    // Frozen window (vault): 990 × 660
    out property <length> window-w: 990px;
    out property <length> window-h: 660px;

    // Knobs — compact LX sizes (42px matches original Meridian).
    out property <length> knob-d: 42px;         // default knob diameter
    out property <length> knob-d-sm: 38px;      // small variant for dense footer rows
    out property <length> knob-stroke: 3.5px;   // arc / track thickness
    out property <length> knob-pointer: 5px;    // pointer cap diameter
    out property <length> knob-gap: 2px;        // gap between knob graphic and labels
}
