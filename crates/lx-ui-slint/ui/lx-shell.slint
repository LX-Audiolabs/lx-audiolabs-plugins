// Frozen plugin shell zones — Header / Left / Main / Right / Footer.
// Vault ui-layout-spec: 990×660, header 50, footer 110, right bar 155.
//
// Canonical composition:
//
//   VerticalLayout {
//       spacing: 0;
//       LxShellHeader {
//           plugin-name: "MERIDIAN";
//           HorizontalLayout {
//               LxToggleBtn { label: "MONO"; ... }
//               LxToggleBtn { label: "DELTA"; ... }
//               LxToggleBtn { label: "BYPASS"; ... }
//           }
//       }
//       LxShellBody {
//           LxShellLeft  { title: "VAULT PRESETS"; /* ... */ }
//           LxShellMain  { /* spectrum + EQ */ }
//           LxShellRight { title: "OUTPUT LEVEL";  /* meters */ }
//       }
//       LxShellFooter { /* compressor / pan / width / reset */ }
//   }
//
// LxShellHeader accepts caller-supplied children on the right side, which are
// automatically vertically centered. LxShellBody is the horizontal body row.

import { Lx } from "lx-theme.slint";
import { LxLineEdit } from "lx-controls.slint";

// ── Zones ────────────────────────────────────────────────────────────────────

/// Left sidebar (vault / presets). Default 180px.
export component LxShellLeft inherits Rectangle {
    in property <length> bar-width: Lx.left-bar-w;
    in property <string> title: "";

    // Fixed width only — Slint forbids width + min/max-width together.
    width: root.bar-width;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    background: @linear-gradient(90deg, Lx.panel 0%, Lx.well-hi 100%);
    border-width: 0px;
    // right seam
    // (border on full rect is ok; seam via nested edge)

    VerticalLayout {
        padding: 8px;
        spacing: Lx.gap-sm;

        if root.title != "": Text {
            text: root.title;
            font-size: 13px;
            font-weight: 700;
            color: Lx.text;
            vertical-stretch: 0;
        }

        @children
    }

    // Seam line on the right edge of left bar
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Lx.edge-dark;
    }
}

/// Center main panel — fills remaining space.
/// min-width:0 so left/right frozen bars are not shoved off-screen.
export component LxShellMain inherits Rectangle {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 0px;
    clip: true;
    background: @linear-gradient(180deg, Lx.window 0%, Lx.stage 100%);

    VerticalLayout {
        padding: 6px;
        spacing: 6px;
        @children
    }
}

/// Right sidebar (output level / meters / gonio). Frozen 155px.
export component LxShellRight inherits Rectangle {
    in property <length> bar-width: Lx.right-bar-w;
    in property <string> title: "OUTPUT LEVEL";

    // Fixed width only — no min/max alongside width.
    width: root.bar-width;
    horizontal-stretch: 0;
    vertical-stretch: 1;
    background: @linear-gradient(270deg, Lx.panel 0%, Lx.section 100%);

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        if root.title != "": Text {
            text: root.title;
            font-size: 12px;
            font-weight: 600;
            color: Lx.text-secondary;
            vertical-stretch: 0;
        }

        @children
    }

    // Seam line on the left edge of right bar
    Rectangle {
        x: 0;
        width: 1px;
        height: 100%;
        background: Lx.edge-dark;
    }
}

/// Footer strip. Frozen 110px.
export component LxShellFooter inherits Rectangle {
    in property <length> bar-height: Lx.footer-h;

    height: root.bar-height;
    vertical-stretch: 0;
    horizontal-stretch: 1;
    background: @linear-gradient(0deg, Lx.panel 0%, Lx.well-hi 100%);
    border-width: 0px;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        alignment: center;
        @children
    }
}

// ── Brand logo (shared SVG wordmark) ─────────────────────────────────────────

/// LX Audiolabs SVG wordmark. Optional click → fixed UI zoom menu (75/100/125%).
/// Used by LxShellHeader and compact headers (Lucent-Relay).
export component LxBrandLogo inherits Rectangle {
    /// Current UI zoom percent (75, 100, or 125).
    in-out property <int> ui-zoom-percent: 100;
    /// When false, logo is display-only (no menu) — compact plugins.
    in property <bool> enable-zoom: true;
    callback ui-zoom-changed(int);

    property <bool> menu-open: false;

    width: 148px;
    height: 28px;
    background: transparent;
    // Allow zoom menu to paint below the logo (outside 28px bounds).
    clip: false;
    z: 100;

    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: @image-url("assets/lx-logo.svg");
        image-fit: contain;
    }

    // Soft hover cue when zoom is available
    if root.enable-zoom && logo-ta.has-hover: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 3px;
        background: #ff731a18;
    }

    logo-ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.enable-zoom ? MouseCursor.pointer : MouseCursor.default;
        clicked => {
            if root.enable-zoom {
                root.menu-open = !root.menu-open;
            }
        }
    }

    // Dropdown under logo — Rectangle overlay (not PopupWindow; DAW hit-tests).
    if root.enable-zoom && root.menu-open: Rectangle {
        x: 0px;
        y: parent.height + 4px;
        width: 112px;
        height: 102px;
        z: 200;
        border-radius: Lx.radius-md;
        background: @linear-gradient(180deg, Lx.section 0%, Lx.panel 100%);
        border-width: 1px;
        border-color: Lx.stage-rim;
        drop-shadow-offset-x: 0px;
        drop-shadow-offset-y: 3px;
        drop-shadow-blur: 8px;
        drop-shadow-color: Lx.shadow-hard;

        VerticalLayout {
            padding: 4px;
            spacing: 2px;

            Text {
                text: "UI SCALE";
                font-size: 9px;
                font-weight: 700;
                color: Lx.text-muted;
                horizontal-alignment: center;
                vertical-stretch: 0;
            }

            for step[i] in [75, 100, 125]: Rectangle {
                height: 26px;
                vertical-stretch: 0;
                border-radius: Lx.radius-sm;
                background: root.ui-zoom-percent == step
                    ? #ff731a33
                    : (step-ta.has-hover ? Lx.control-hover : transparent);

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: space-between;

                    Text {
                        text: step + "%";
                        font-size: 12px;
                        font-weight: root.ui-zoom-percent == step ? 700 : 500;
                        color: root.ui-zoom-percent == step ? Lx.amber-hot : Lx.text;
                        vertical-alignment: center;
                    }
                    if root.ui-zoom-percent == step: Text {
                        text: "✓";
                        font-size: 12px;
                        color: Lx.amber;
                        vertical-alignment: center;
                    }
                }

                step-ta := TouchArea {
                    clicked => {
                        root.ui-zoom-percent = step;
                        root.menu-open = false;
                        root.ui-zoom-changed(step);
                    }
                }
            }
        }
    }
}

// ── Header ───────────────────────────────────────────────────────────────────

/// Brand + plugin name + version (left). Plugin-specific actions as children
/// (right, auto-centered). Frozen 50px.
///
/// Style rule: free choice of which controls, but all use default Lx chrome
/// (Lx.button-h / LxButton / LxToggleBtn / LxDangerBtn / LxSelectTrigger /
/// LxLineEdit). No local height overrides, no `small` in the header.
///
/// Logo click opens fixed UI zoom menu (75/100/125%). Forward
/// `ui-zoom-percent` / `ui-zoom-changed` from the plugin Window root.
export component LxShellHeader inherits Rectangle {
    in property <string> plugin-name: "";
    in property <string> version: "";
    in property <string> status-text: "";

    // Product UI zoom (fixed steps). Wired by plugins to lx-slint-editor::UiZoom.
    in-out property <int> ui-zoom-percent: 100;
    in property <bool> enable-ui-zoom: true;
    callback ui-zoom-changed(int);

    // Optional centered instance/name field (Lucent). Layout-owned — never
    // absolute-overlay: free-geometry LineEdit defaults width:100% and paints
    // over logo + actions.
    in property <bool> show-instance-name: false;
    in-out property <string> instance-name: "";
    in property <string> instance-placeholder: "Instance name";
    in property <length> instance-field-width: 170px;
    callback instance-name-changed(string);

    height: Lx.header-h;
    vertical-stretch: 0;
    // Menu drops below header — must paint over body siblings.
    clip: false;
    z: 50;
    background: @linear-gradient(180deg, Lx.section 0%, Lx.window 70%, Lx.void 100%);
    border-width: 0px;

    // Bottom hairline seam
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Lx.edge-dark;
    }
    // Amber brand accent rail under header edge
    Rectangle {
        y: parent.height - 2px;
        width: 100%;
        height: 1px;
        background: #ff731a33;
    }

    // Full-height row: brand LEFT | optional name CENTER | actions RIGHT.
    // Cross-axis: VerticalLayout wrappers with alignment:center (HorizontalLayout
    // alone with vertical-stretch:0 pins children to the top of the 50px header).
    HorizontalLayout {
        width: 100%;
        height: 100%;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 0;
        alignment: stretch;

        // ── Left: logo + plugin info ──
        VerticalLayout {
            horizontal-stretch: 0;
            vertical-stretch: 1;
            alignment: center;

            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                vertical-stretch: 0;

                LxBrandLogo {
                    enable-zoom: root.enable-ui-zoom;
                    ui-zoom-percent <=> root.ui-zoom-percent;
                    ui-zoom-changed(p) => { root.ui-zoom-changed(p); }
                }

                Rectangle {
                    width: 14px;
                    background: transparent;
                }
                Rectangle {
                    width: 1px;
                    height: 28px;
                    background: #2e3838;
                }
                Rectangle {
                    width: 14px;
                    background: transparent;
                }

                VerticalLayout {
                    spacing: 0;
                    alignment: center;
                    horizontal-stretch: 0;

                    Text {
                        text: root.plugin-name;
                        font-size: 13px;
                        font-weight: 700;
                        color: #ffa64d;
                    }
                    if root.version != "": Text {
                        text: "v" + root.version;
                        font-size: 10px;
                        color: #808080;
                    }
                }

                if root.status-text != "": Text {
                    text: root.status-text;
                    font-size: Lx.font-sm;
                    color: Lx.text-secondary;
                    vertical-alignment: center;
                }
            }
        }

        // ── Center: stretch; name field vertically centered like brand/actions ──
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            vertical-stretch: 1;
            alignment: center;

            HorizontalLayout {
                horizontal-stretch: 0;
                vertical-stretch: 0;
                alignment: center;

                if root.show-instance-name: LxLineEdit {
                    text <=> root.instance-name;
                    placeholder-text: root.instance-placeholder;
                    field-width: root.instance-field-width;
                    horizontal-stretch: 0;
                    vertical-stretch: 0;
                    edited(t) => { root.instance-name-changed(t); }
                    accepted(t) => { root.instance-name-changed(t); }
                    committed(t) => { root.instance-name-changed(t); }
                }
            }
        }

        // ── Right: caller-supplied actions, vertically centered in header ──
        VerticalLayout {
            horizontal-stretch: 0;
            vertical-stretch: 1;
            alignment: center;

            HorizontalLayout {
                spacing: 4px;
                alignment: center;
                horizontal-stretch: 0;
                vertical-stretch: 0;

                @children
            }
        }
    }
}

// ── Sugar: body row only ─────────────────────────────────────────────────────

/// Horizontal body row. Children = LxShellLeft / LxShellMain / LxShellRight.
/// Pair with a sibling `LxShellHeader` above and `LxShellFooter` below inside a
/// VerticalLayout for the full plugin table.
export component LxShellBody inherits Rectangle {
    background: Lx.window;
    vertical-stretch: 1;
    horizontal-stretch: 1;

    HorizontalLayout {
        vertical-stretch: 1;
        horizontal-stretch: 1;
        min-width: 0px;
        spacing: 0;
        // Keep left | main | right in bounds — don't let main preferred-width overflow.
        alignment: stretch;
        @children
    }
}
