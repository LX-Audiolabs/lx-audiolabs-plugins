// Shared dialogs used by every plugin (vault path, etc.).

import { Lx } from "lx-theme.slint";
import { LxButton } from "lx-chrome.slint";
import { LxLineEdit } from "lx-controls.slint";

/// Full-window vault path dialog (Aether CI).
/// Parent must size it to the window so the dimmer covers FFT/EQ Path layers:
///
///   setup_popup := LxVaultSetupPopup {
///       width: root.width; height: root.height; x: 0; y: 0;
///       path <=> root.vault_path;
///       plugin-label: "Meridian";
///       saved(p) => { root.vault_path_changed(p); }
///   }
///   // setup_popup.show();
///
/// Full-window + solid dimmer keeps the card above software-renderer Path draws.
export component LxVaultSetupPopup inherits PopupWindow {
    in-out property <string> path: "";
    // Shown in subtitle: "Configure your Vault path for {plugin-label}:"
    in property <string> plugin-label: "Plugin";
    // Host sets this after reading OS clipboard (Ctrl+V often stolen by DAW).
    in property <string> paste-status: "";

    callback saved(string);
    // Host must read OS clipboard and assign `path` (see plugin editor).
    callback paste-requested();

    close-policy: close-on-click-outside;

    // Dimmer fills the popup area (parent sets width/height = window).
    Rectangle {
        width: 100%;
        height: 100%;
        background: #000000b3;

        // Centered card — Aether setup chrome
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 420px;
            // Content-fit: fixed heights let the layout distribute leftover
            // space into the gaps. preferred-height keeps gaps at gap-md.
            height: vl.preferred-height;
            background: Lx.panel;
            border-radius: Lx.radius-md;
            border-width: 1px;
            border-color: Lx.steel;

            vl := VerticalLayout {
                padding: Lx.pad-md;
                spacing: Lx.gap-md;

                Text {
                    text: "LX AUDIOLABS — SETUP";
                    font-size: Lx.font-lg;
                    font-weight: 700;
                    color: Lx.amber;
                    vertical-stretch: 0;
                }
                Text {
                    text: "Configure your Vault path for " + root.plugin-label + ":";
                    font-size: Lx.font-md;
                    color: Lx.text-secondary;
                    vertical-stretch: 0;
                }
                HorizontalLayout {
                    spacing: Lx.gap-sm;
                    vertical-stretch: 0;
                    LxLineEdit {
                        placeholder-text: "Enter Vault absolute path...";
                        text <=> root.path;
                        horizontal-stretch: 1;
                    }
                    // DAW hosts often steal Ctrl+V — explicit paste via OS clipboard.
                    LxButton {
                        text: "PASTE";
                        min-width: 64px;
                        clicked => { root.paste-requested(); }
                    }
                }
                if root.paste-status != "": Text {
                    text: root.paste-status;
                    font-size: Lx.font-xs;
                    color: Lx.crimson;
                    vertical-stretch: 0;
                }
                HorizontalLayout {
                    spacing: Lx.gap-md;
                    vertical-stretch: 0;

                    LxButton {
                        text: "SAVE";
                        primary: true;
                        clicked => {
                            root.saved(root.path);
                            root.close();
                        }
                    }
                    LxButton {
                        text: "CANCEL";
                        clicked => { root.close(); }
                    }
                }
            }
        }
    }
}
