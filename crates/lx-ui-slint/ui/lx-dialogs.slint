// Shared dialogs used by every plugin (vault path, etc.).

import { Lx } from "lx-theme.slint";
import { LxButton } from "lx-chrome.slint";
import { LxLineEdit } from "lx-controls.slint";

/// Full-window vault path overlay (Rectangle, not PopupWindow).
///
/// PopupWindow + full-window dimmer TouchArea ate all hits in embedded
/// DAW hosts (TextInput + PASTE dead). Stack this last on the Window.
///
/// **Draft path (important):** do NOT live-bind `path` to the plugin's saved
/// vault path. Continuous `path: root.vault_path` re-applies every frame and
/// fights TextInput (Meridian spectrum sync made this obvious; Aether less so).
/// Seed once when opening, two-way-bind a draft property, commit on SAVE:
///
///   in-out property <string> vault_setup_path: "";
///   // SETUP clicked:
///   //   root.vault_setup_path = root.vault_path;
///   //   root.vault_setup_open = true;
///   vault_setup := LxVaultSetupOverlay {
///       width: 100%; height: 100%;
///       open <=> root.vault_setup_open;
///       path <=> root.vault_setup_path;
///       plugin-label: "Meridian";
///       paste-status: root.vault_paste_status;
///       paste-requested => { root.vault_paste_requested(); }
///       saved(p) => {
///           root.vault_path = p;
///           root.vault_path_changed(p);
///       }
///   }
///   // PASTE handler: set vault_setup_path (draft), not vault_path.
export component LxVaultSetupOverlay inherits Rectangle {
    in-out property <bool> open: false;
    // Editable draft. Parent two-ways a draft prop; SAVE commits.
    in-out property <string> path: "";
    in property <string> plugin-label: "Plugin";
    in property <string> paste-status: "";

    callback saved(string);
    callback paste-requested();
    callback closed();

    visible: root.open;
    z: 1000;
    width: 100%;
    height: 100%;
    background: #000000b3;

    // Margin strips only — never cover the card (full-size TA steals hits).
    TouchArea {
        x: 0px;
        y: 0px;
        width: 100%;
        height: max(0px, card.y);
        clicked => { root.open = false; root.closed(); }
    }
    TouchArea {
        x: 0px;
        y: card.y + card.height;
        width: 100%;
        height: max(0px, parent.height - (card.y + card.height));
        clicked => { root.open = false; root.closed(); }
    }
    TouchArea {
        x: 0px;
        y: card.y;
        width: max(0px, card.x);
        height: card.height;
        clicked => { root.open = false; root.closed(); }
    }
    TouchArea {
        x: card.x + card.width;
        y: card.y;
        width: max(0px, parent.width - (card.x + card.width));
        height: card.height;
        clicked => { root.open = false; root.closed(); }
    }

    card := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 420px;
        height: vl.preferred-height;
        background: Lx.panel;
        border-radius: Lx.radius-md;
        border-width: 1px;
        border-color: Lx.steel;

        // One-shot: focus path after layout. 0ms races first layout in DAW hosts
        // (esp. Meridian with heavy Path layers); 16ms ≈ 1 frame @ 60 Hz.
        focus-timer := Timer {
            interval: 16ms;
            running: false;
            triggered => {
                // FocusScope first so tab order / key capture is in the card,
                // then TextInput via LxLineEdit.forward-focus.
                card-focus.focus();
                path-input.focus-input();
                focus-timer.running = false;
            }
        }

        // Fill the card — zero-size FocusScope never receives focus.
        card-focus := FocusScope {
            width: 100%;
            height: 100%;
            // When focused but TextInput doesn't have it, re-target.
            // Escape closes (same idea as Popup close-on-escape).
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.open = false;
                    root.closed();
                    return accept;
                }
                return reject;
            }

            vl := VerticalLayout {
                padding: Lx.pad-md;
                spacing: Lx.gap-md;

                Text {
                    text: "LX AUDIOLABS — SETUP";
                    font-size: Lx.font-lg;
                    font-weight: 700;
                    color: Lx.amber;
                    vertical-stretch: 0;
                }
                Text {
                    text: "Configure your Vault path for " + root.plugin-label + ":";
                    font-size: Lx.font-md;
                    color: Lx.text-secondary;
                    vertical-stretch: 0;
                }
                HorizontalLayout {
                    spacing: Lx.gap-sm;
                    vertical-stretch: 0;
                    path-input := LxLineEdit {
                        placeholder-text: "Enter Vault absolute path...";
                        text <=> root.path;
                        horizontal-stretch: 1;
                    }
                    LxButton {
                        text: "PASTE";
                        min-width: 64px;
                        // Host reads OS clipboard (DAW often steals Ctrl+V).
                        // Native Ctrl+V also works when platform clipboard_text
                        // uses clipboard_get_retry (slint-baseview).
                        clicked => { root.paste-requested(); }
                    }
                }
                if root.paste-status != "": Text {
                    text: root.paste-status;
                    font-size: Lx.font-xs;
                    color: Lx.crimson;
                    vertical-stretch: 0;
                }
                HorizontalLayout {
                    spacing: Lx.gap-md;
                    vertical-stretch: 0;

                    LxButton {
                        text: "SAVE";
                        primary: true;
                        clicked => {
                            root.saved(root.path);
                            root.open = false;
                            root.closed();
                        }
                    }
                    LxButton {
                        text: "CANCEL";
                        clicked => {
                            root.open = false;
                            root.closed();
                        }
                    }
                }
            }
        }
    }

    changed open => {
        if root.open {
            focus-timer.running = true;
        } else {
            focus-timer.running = false;
        }
    }
}
